---
export interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = 'Commercial and technical hires for growth companies, found by one recruiter who runs every search himself.',
  image = '/og-image.png',
  article = false,
  noindex = false,
} = Astro.props;

import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader/opsz.css';
import '../styles/global.css';
import '../styles/site.css';
import { navLinks, contact } from '../data/site';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Bolt Search</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonicalURL} />
  <meta name="theme-color" content="#070B0D" />

  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={`${title} | Bolt Search`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | Bolt Search`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(image, Astro.site)} />

  <link rel="icon" type="image/png" href="/bolt-favicon.png" />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-DH9Y7K83RM"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-DH9Y7K83RM');
  </script>

  <!-- Ahrefs Analytics -->
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="iD4ebR6FRgq0JJoixaG7vw" async></script>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': article ? 'Article' : 'Organization',
    name: 'Bolt Search',
    url: 'https://www.bolt-search.com',
    description,
    logo: 'https://www.bolt-search.com/bolt-search-logo.png',
    sameAs: ['https://www.linkedin.com/company/bolt-search'],
  })} />

  <script is:inline>document.documentElement.classList.add('bs-js');</script>
</head>
<body class="bs">
  <header class="bs-nav">
    <a href="/" class="bs-wordmark">Bolt Search</a>
    <nav aria-label="Main" class="bs-links">
      {navLinks.map((l) => (
        <a href={l.href} aria-current={currentPath === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <a href="/#brief" class="bs-btn bs-btn-accent bs-nav-action">Send a brief</a>
  </header>

  <main>
    <slot />
  </main>

  <footer class="bs-foot">
    <div class="bs-foot-cols">
      <div><p>Bolt Search</p><p>Commercial and technical hires for growth companies.</p></div>
      <div><p>Pages</p>{navLinks.map((l) => <p><a href={l.href}>{l.label}</a></p>)}<p><a href="/contact/">Contact</a></p></div>
      <div><p>Contact</p><p><a href={`mailto:${contact.email}`}>{contact.email}</a></p><p><a href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a></p></div>
      <div><p>Where</p><p>{contact.where}</p></div>
    </div>
    <svg class="bs-foot-mark" viewBox="0 0 1000 176" aria-hidden="true" focusable="false"><text x="0" y="148" textLength="1000" lengthAdjust="spacingAndGlyphs">Bolt Search</text></svg>
    <p class="bs-foot-legal">© {year} Bolt Search. Example documents on this site are illustrative.</p>
  </footer>

  <script>
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.12 }
    );
    document.querySelectorAll('[data-reveal], [data-diagram], .bs-log, .bs-slip').forEach((el) => io.observe(el));

    // The lit name moves through the placed roles every two seconds.
    const names = Array.from(document.querySelectorAll('[data-names] .bs-name'));
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (names.length && !still) {
      let i = 0;
      setInterval(() => {
        names[i].classList.remove('is-lit');
        i = (i + 1) % names.length;
        names[i].classList.add('is-lit');
      }, 2000);
    }
  </script>
</body>
</html>
