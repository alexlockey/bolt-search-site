---
export interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = "Bolt Search recruits mid-level commercial and technical people for growth companies: sales, solutions and estimating hires, and first UK and EMEA hires for US startups.",
  image = "/og-image.png",
  article = false,
  noindex = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentYear = new Date().getFullYear();
const currentPath = Astro.url.pathname;

import '../styles/global.css';

const navLinks = [
  { href: '/#how', label: 'How it works' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact', cta: true },
];
---

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | Bolt Search</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex, nofollow">}
  <link rel="canonical" href={canonicalURL}>

  <meta property="og:type" content={article ? "article" : "website"}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={`${title} | Bolt Search`}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL(image, Astro.site)}>

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={`${title} | Bolt Search`}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={new URL(image, Astro.site)}>

  <link rel="icon" type="image/png" href="/bolt-favicon.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-DH9Y7K83RM"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-DH9Y7K83RM');
  </script>

  <!-- Ahrefs Analytics -->
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="iD4ebR6FRgq0JJoixaG7vw" async></script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": article ? "Article" : "Organization",
    "name": "Bolt Search",
    "url": "https://www.bolt-search.com",
    "description": description,
    "logo": "https://www.bolt-search.com/bolt-search-logo.png",
    "sameAs": [
      "https://www.linkedin.com/company/bolt-search"
    ]
  })} />

  <style>
    .site-nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--color-white);
    }

    .nav-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: var(--space-md) 0;
      position: relative;
    }

    .nav-logo-img {
      height: 34px;
      width: auto;
    }

    .nav-links {
      display: flex;
      gap: var(--space-xl);
      list-style: none;
      align-items: center;
    }

    .nav-links a {
      color: var(--color-fg-muted);
      font-size: 0.9375rem;
      font-weight: 500;
    }

    .nav-links a:hover,
    .nav-links a[aria-current="page"] {
      color: var(--color-fg);
    }

    .nav-links a.nav-cta {
      padding: 0.5rem 1.125rem;
      background: var(--color-navy);
      color: var(--color-white);
      border-radius: 6px;
    }

    .nav-links a.nav-cta:hover {
      background: var(--color-accent-dark);
      color: var(--color-white);
    }

    .menu-toggle {
      display: none;
      background: none;
      border: 0;
      cursor: pointer;
      padding: 0.5rem;
      color: var(--color-fg);
    }

    @media (max-width: 720px) {
      .menu-toggle { display: block; }
      .nav-links {
        display: none;
        position: absolute;
        top: 100%;
        left: calc(-1 * var(--space-lg));
        right: calc(-1 * var(--space-lg));
        background: var(--color-white);
        flex-direction: column;
        align-items: flex-start;
        padding: var(--space-md) var(--space-lg) var(--space-xl);
        gap: var(--space-lg);
      }
      .nav-links.open { display: flex; }
    }

    .site-footer {
      background: var(--color-navy);
      color: rgba(255, 255, 255, 0.78);
      padding: var(--space-3xl) 0 var(--space-xl);
    }

    .footer-top {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: var(--space-xl);
      margin-bottom: var(--space-2xl);
    }

    .footer-brand p {
      color: rgba(255, 255, 255, 0.7);
      font-size: 0.9375rem;
      max-width: 26rem;
      margin-top: var(--space-md);
    }

    .footer-logo {
      height: 28px;
      width: auto;
      filter: brightness(0) invert(1);
    }

    .footer-links {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-lg);
      list-style: none;
    }

    .footer-links a {
      color: rgba(255, 255, 255, 0.78);
      font-size: 0.9375rem;
    }

    .footer-links a:hover { color: var(--color-white); }

    .footer-bottom {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: var(--space-sm);
      font-size: 0.8125rem;
      color: rgba(255, 255, 255, 0.6);
    }
  </style>
</head>
<body>
  <nav class="site-nav" aria-label="Main">
    <div class="container-wide">
      <div class="nav-inner">
        <a href="/" class="nav-logo">
          <img src="/bolt-search-logo.png" alt="Bolt Search" class="nav-logo-img" width="153" height="34" />
        </a>

        <button class="menu-toggle" id="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>

        <ul class="nav-links" id="nav-links">
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                aria-current={currentPath === link.href ? 'page' : undefined}
                class={link.cta ? 'nav-cta' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container-wide">
      <div class="footer-top">
        <div class="footer-brand">
          <a href="/"><img src="/bolt-search-logo.png" alt="Bolt Search" class="footer-logo" width="126" height="28" /></a>
          <p>Commercial and technical hires for growth companies.</p>
        </div>
        <ul class="footer-links">
          <li><a href="/#how">How it works</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="https://www.linkedin.com/company/bolt-search" target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
      </div>

      <div class="footer-bottom">
        <span>&copy; {currentYear} Bolt Search</span>
        <span>UK-based. Working with UK and US companies.</span>
      </div>
    </div>
  </footer>

  <script>
    const menuToggle = document.getElementById('menu-toggle');
    const navLinks = document.getElementById('nav-links');
    menuToggle?.addEventListener('click', () => {
      const open = navLinks?.classList.toggle('open') ?? false;
      menuToggle.setAttribute('aria-expanded', String(open));
      menuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
  </script>
</body>
</html>
