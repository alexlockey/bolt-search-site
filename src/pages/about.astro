---
import Layout from '../layouts/Layout.astro';

const title = "About Bolt Search";
const description = "Bolt Search is a founder-led recruitment firm run by Alex Lockey. Over 10 years of commercial and leadership placements, including CRO, CCO, account director and business development hires.";

const principles = [
  {
    heading: "Few searches at once",
    body: "We take on a small number of roles at a time, so each one gets real attention rather than a database search and a pile of CVs.",
  },
  {
    heading: "Straight answers",
    body: "If a candidate is not right, we say so. If the market cannot give you what the brief asks for, you hear that in week one, not week six.",
  },
  {
    heading: "Discretion",
    body: "Replacement hires and new market entries are often confidential. We run them quietly, for clients and candidates alike.",
  },
];
---

<Layout title={title} description={description}>
  <section class="about-hero">
    <div class="container-wide about-grid">
      <div>
        <h1>A small search firm. Every brief run by the founder.</h1>
        <p class="lede">
          Bolt Search has recruited commercial and leadership people for more than 10 years. Placements include CROs, CCOs, account directors and business development hires for growing companies in the UK and abroad.
        </p>
      </div>
      <figure class="portrait">
        <img src="/alex-lockey.jpg" alt="Alex Lockey" width="360" height="360" loading="eager" />
        <figcaption>
          <strong>Alex Lockey</strong>
          Founder and Managing Partner
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section section-subtle">
    <div class="container about-copy">
      <h2>Alex Lockey</h2>
      <p>
        Alex founded Bolt Search and runs every search himself, from the first call to the start date. He has spent his career around commercial teams: hiring them, building them and working alongside the people who lead them.
      </p>
      <p>
        He trained as an engineer (BEng Aeronautical Engineering, University of Bristol), which helps when a hire has to hold a technical conversation with a buyer, not only a commercial one.
      </p>
      <p>
        <a href="https://www.linkedin.com/in/alexlockey1/" target="_blank" rel="noopener">Alex on LinkedIn</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-wide">
      <h2 class="section-heading">How we work</h2>
      <div class="grid-3">
        {principles.map((p) => (
          <div class="card">
            <h3>{p.heading}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container-wide closing">
      <h2>Have a role in mind?</h2>
      <p>Send a short note on the role and what it has to achieve. Alex will reply personally.</p>
      <a href="/contact/" class="btn btn-white">Tell us about the role</a>
    </div>
  </section>
</Layout>

<style>
  .about-hero {
    padding: var(--space-4xl) 0 var(--space-3xl);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--space-3xl);
    align-items: center;
  }

  .about-grid h1 {
    margin-bottom: var(--space-lg);
  }

  .portrait img {
    border-radius: 12px;
    width: 100%;
    max-width: 360px;
  }

  .portrait figcaption {
    margin-top: var(--space-md);
    color: var(--color-fg-subtle);
    font-size: 0.9375rem;
  }

  .portrait strong {
    display: block;
    color: var(--color-fg);
  }

  .about-copy h2 {
    margin-bottom: var(--space-lg);
  }

  .section-heading {
    margin-bottom: var(--space-2xl);
  }

  .card h3 {
    margin-bottom: var(--space-sm);
  }

  .card p {
    margin-bottom: 0;
  }

  .closing {
    max-width: 44rem;
  }

  .closing h2 {
    margin-bottom: var(--space-md);
  }

  .closing p {
    margin-bottom: var(--space-xl);
  }

  @media (max-width: 768px) {
    .about-hero { padding: var(--space-3xl) 0 var(--space-2xl); }
    .about-grid { grid-template-columns: 1fr; gap: var(--space-xl); }
  }
</style>
