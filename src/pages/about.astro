---
import Layout from '../layouts/Layout.astro';
import { principles, facts, placements, quotes, hero, openSearches, searchStages, straightUpdate, confidentialSearch } from '../data/site';

const title = 'Alex Lockey, founder of Bolt Search';
const description = 'Alex Lockey has recruited since 2007 and founded Bolt Search in 2016. He runs every search himself, with a written note on every name.';
---

<Layout title={title} description={description}>
  <section class="bs-page-head">
    <div class="bs-wrap bs-page-grid">
      <div>
        <h1 class="bs-page-h1" data-reveal>Alex Lockey</h1>
        <p class="bs-two-tone" data-reveal style="--d:1">Founder of Bolt Search. <span>Recruiting since 2007, and still running every search himself.</span></p>
      </div>
      <img class="bs-portrait" src="/images/alex-headshot-600.webp" alt="Alex Lockey" width="600" height="804" loading="eager" data-reveal style="--d:2" />
    </div>
  </section>

  <section class="bs-about" aria-labelledby="bs-story-h">
    <div class="bs-wrap">
      <h2 id="bs-story-h" class="bs-h2 bs-about-h" data-reveal>The short version</h2>
      <div class="bs-about-text" data-reveal>
        <div class="bs-para">
          Alex has recruited since <mark class="hl-a">2007</mark> and founded Bolt Search in <mark class="hl-a">2016</mark>. Over that time he has made <mark class="hl-b">more than fifty placements</mark>, from specialists and heads of function to <mark class="hl-b">fractional CROs</mark> and board members.
        </div>
        <div class="bs-para">
          He trained as an <mark class="hl-b">engineer</mark>, with a BEng in Aeronautical Engineering from the <mark class="hl-c">University of Bristol</mark>, which helps when a hire has to hold a technical conversation with a buyer as well as a commercial one. He works from the UK with companies in the <mark class="hl-a">UK and the US</mark>. <a href="/#brief" class="hl-go">Tell him about your role.</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bs-principles-wrap" aria-labelledby="bs-how-h">
    <div class="bs-wrap">
      <h2 id="bs-how-h" class="bs-h2 bs-principles-h" data-reveal>How he works</h2>
      <ul class="bs-principles">
        <li class="bs-principle">
          <p class="bs-two-tone" data-reveal>{principles[0].lead} <span>{principles[0].rest}</span></p>
          <div class="bs-app bs-mini" data-ui data-reveal style="--d:1">
            <div class="bs-app-bar"><span class="bs-app-title">Open searches</span><span class="bs-app-tag">Example</span></div>
            <ul class="bs-track-list">
              {openSearches.map((o) => (
                <li>
                  <span class="bs-app-id">{o.role}</span>
                  <span class="bs-app-state">{searchStages[o.stage]} · {o.week}</span>
                  <svg class="bs-track" viewBox="0 0 200 12" aria-label={`Stage ${o.stage + 1} of ${searchStages.length}: ${searchStages[o.stage]}`} role="img">
                    <line x1="6" y1="6" x2="194" y2="6" class="bs-track-line" />
                    {searchStages.map((_, i) => (
                      <circle cx={6 + i * 47} cy="6" r="5" class={i < o.stage ? 'is-done' : i === o.stage ? 'is-now' : 'is-next'} />
                    ))}
                  </svg>
                </li>
              ))}
            </ul>
          </div>
        </li>
        <li class="bs-principle">
          <p class="bs-two-tone" data-reveal>{principles[1].lead} <span>{principles[1].rest}</span></p>
          <div class="bs-app bs-mini" data-ui data-reveal style="--d:1">
            <div class="bs-app-bar"><span class="bs-app-title">{straightUpdate.title}</span><span class="bs-app-tag">Example</span></div>
            <dl class="bs-app-note bs-mini-note bs-mini-meta">
              {straightUpdate.meta.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
            </dl>
            <div class="bs-mini-body">
              <p>{straightUpdate.body}</p>
              <ul class="bs-options">{straightUpdate.options.map((o, i) => <li class={i === 1 ? 'is-pick' : undefined}>{o}</li>)}</ul>
              <p>{straightUpdate.close}</p>
            </div>
          </div>
        </li>
        <li class="bs-principle">
          <p class="bs-two-tone" data-reveal>{principles[2].lead} <span>{principles[2].rest}</span></p>
          <div class="bs-app bs-mini" data-ui data-reveal style="--d:1">
            <div class="bs-app-bar"><span class="bs-app-title">Search · Replacement hire</span><span class="bs-app-tag">Confidential, example</span></div>
            <dl class="bs-app-note bs-mini-note">
              {confidentialSearch.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
            </dl>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="bs-record" aria-labelledby="bs-log-h">
    <div class="bs-wrap bs-record-grid bs-record-grid-flush">
      <div>
        <h2 id="bs-log-h" class="bs-h2" data-reveal>Track record</h2>
        <dl class="bs-figures bs-figures-gap" data-reveal>
          {facts.slice(0, 3).map((f) => <div><dt>{f.figure}</dt><dd>{f.label}</dd></div>)}
        </dl>
      </div>
      <div class="bs-log" data-ui data-reveal style="--d:1">
        <div class="bs-app-bar"><span class="bs-app-title">Placement log</span><span class="bs-app-tag">Roles only, no names</span></div>
        <ul>
          {placements.map((p, k) => (
            <li style={`--k:${k}`}>
              <span class="bs-log-check" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="16" height="16"><circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5" /><polyline points="5,8.2 7.2,10.3 11,6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
              </span>
              <span class="bs-log-role">{p.role}</span>
              <span class="bs-log-co">{p.company}</span>
              <span class="bs-log-year">{p.year}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="bs-letter" aria-labelledby="bs-words-h">
    <div class="bs-wrap bs-letter-grid">
      <h2 id="bs-words-h" class="bs-h2" data-reveal>In their words</h2>
      <div class="bs-letter-body">
        {quotes.map((q, i) => (
          <blockquote class={i === 0 ? 'bs-letter-open' : undefined} data-reveal style={`--d:${i % 2}`}>
            <p>{q.text}</p>
            <footer>{q.who}</footer>
          </blockquote>
        ))}
        <p class="bs-letter-sign">Paraphrased from fifteen LinkedIn recommendations. <a href={hero.second.href}>Ask to speak to a reference</a>.</p>
      </div>
    </div>
  </section>

  <section class="bs-cta">
    <div class="bs-wrap bs-cta-grid">
      <h2 class="bs-h2" data-reveal>Have a role in mind?</h2>
      <div data-reveal style="--d:1">
        <p class="bs-two-tone">Send a few lines on what the hire must achieve. <span>Alex replies personally.</span></p>
        <a href="/#brief" class="bs-btn bs-btn-accent bs-cta-btn">Tell us about the role</a>
      </div>
    </div>
  </section>
</Layout>
