---
// Phase 3 concept review only. Noindex, out of the sitemap, removed once Alex picks one.
import Layout from '../../layouts/Layout.astro';
import ConceptA from '../../components/home/ConceptA.astro';
import ConceptB from '../../components/home/ConceptB.astro';
import ConceptC from '../../components/home/ConceptC.astro';

export function getStaticPaths() {
  return [{ params: { concept: 'a' } }, { params: { concept: 'b' } }, { params: { concept: 'c' } }];
}

const { concept } = Astro.params as { concept: 'a' | 'b' | 'c' };
const names = { a: 'A, the Dossier', b: 'B, the Instrument', c: 'C, the Partner' };
---

<Layout title={`Concept ${names[concept]}`} concept={concept} noindex={true}>
  {concept === 'a' && <ConceptA />}
  {concept === 'b' && <ConceptB />}
  {concept === 'c' && <ConceptC />}

  <nav class="switcher" aria-label="Concept switcher">
    <span>Concept</span>
    {(['a', 'b', 'c'] as const).map((k) => (
      <a href={`/concepts/${k}/`} aria-current={k === concept ? 'page' : undefined}>{names[k]}</a>
    ))}
  </nav>
</Layout>

<style>
  .switcher {
    position: fixed;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    z-index: 200;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem;
    background: #121220;
    border-radius: 999px;
    font-family: var(--font-mono); /* taste-skill-ignore: approved Plex Mono labels, see CLAUDE.md */
    font-size: 0.75rem;
    max-width: calc(100vw - 1rem);
    overflow-x: auto;
  }

  .switcher span {
    color: rgba(255, 255, 255, 0.6);
    padding: 0 0.5rem;
  }

  .switcher a {
    color: #FFFFFF;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .switcher a[aria-current="page"] {
    background: #FFFFFF;
    color: #121220;
  }
</style>
