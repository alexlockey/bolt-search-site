---
// Phase 3 concept review only. Noindex, out of the sitemap, removed once Alex picks one.
import ConceptLayout from '../../layouts/ConceptLayout.astro';
import Monument from '../../components/concepts/Monument.astro';
import Annual from '../../components/concepts/Annual.astro';
import Sentence from '../../components/concepts/Sentence.astro';
import Performs from '../../components/concepts/Performs.astro';
import Quiet from '../../components/concepts/Quiet.astro';
import Statement from '../../components/concepts/Statement.astro';

export function getStaticPaths() {
  return ['a', 'b', 'c', 'd', 'e', 'f'].map((concept) => ({ params: { concept } }));
}

const { concept } = Astro.params as { concept: 'a' | 'b' | 'c' | 'd' | 'e' | 'f' };
const names = { d: 'D · Product', e: 'E · Quiet', f: 'F · Statement', a: 'A · Round 2', b: 'B · Round 2', c: 'C · Round 2' };
---

<ConceptLayout title={`Concept ${names[concept]}`}>
  <nav class="concept-switch" aria-label="Concept switcher">
    {(['d', 'e', 'f', 'a'] as const).map((k) => (
      <a href={`/concepts/${k}/`} aria-current={k === concept ? 'page' : undefined}>{names[k]}</a>
    ))}
  </nav>

  {concept === 'a' && <Monument />}
  {concept === 'b' && <Annual />}
  {concept === 'c' && <Sentence />}
  {concept === 'd' && <Performs />}
  {concept === 'e' && <Quiet />}
  {concept === 'f' && <Statement />}

</ConceptLayout>

<style is:global>
  /* Review-only bar, static at the very top so it never covers the concept. */
  .concept-switch {
    display: flex;
    justify-content: center;
    gap: 2px;
    padding: 4px;
    background: #111;
    font: 500 13px/1 system-ui, sans-serif;
  }
  .concept-switch a {
    color: #fff;
    padding: 9px 14px;
    text-decoration: none;
    white-space: nowrap;
  }
  .concept-switch a[aria-current="page"] {
    background: #fff;
    color: #111;
  }
  @media (max-width: 480px) {
    .concept-switch a { padding: 9px 8px; }
  }
</style>
