---
import Layout from '../layouts/Layout.astro';
import { contact, nextSteps, exampleReply, briefings } from '../data/site';

const title = 'Tell us about the role';
const description = 'Send Bolt Search a short brief on the role you are hiring for. Alex Lockey reads it and replies personally.';
---

<Layout title={title} description={description}>
  <section class="bs-page-head">
    <div class="bs-wrap bs-contact-grid">
      <div class="bs-contact-copy">
        <h1 class="bs-page-h1" data-reveal>Tell us about the role</h1>
        <p class="bs-two-tone" data-reveal style="--d:1">A few lines is enough. <span>The role, where it sits, and what the person has to achieve in their first year. Alex reads each one and replies personally.</span></p>
      </div>

      <div class="bs-composer" data-ui data-reveal style="--d:1">
        <div class="bs-app-bar"><span class="bs-app-title">New enquiry</span><span class="bs-app-tag">To Alex Lockey</span></div>
        <form class="bs-form" id="contact-form" novalidate>
          <div class="bs-form-row">
            <label class="bb-field"><span>Name</span><input id="name" name="name" required autocomplete="name" maxlength="120" /></label>
            <label class="bb-field"><span>Work email</span><input id="email" name="email" type="email" required autocomplete="email" maxlength="200" /></label>
          </div>
          <div class="bs-form-row">
            <label class="bb-field"><span>Company</span><input id="company" name="company" required autocomplete="organization" maxlength="160" /></label>
            <label class="bb-field"><span>Role to hire</span><input id="role" name="role" required maxlength="160" placeholder="e.g. Founding AE, UK" /></label>
          </div>
          <label class="bb-field"><span>Message</span><textarea id="message" name="message" required maxlength="5000" rows="6" placeholder="Location, timing, salary range if you have one, and anything that makes this hire hard."></textarea></label>
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;height:0;width:0;border:0;padding:0" />
          <div class="bb-actions">
            <button type="submit" class="bb-send">Send the brief</button>
            <p class="bb-status" role="status" aria-live="polite"></p>
          </div>
        </form>
        <div class="bb-done" id="contact-done" hidden tabindex="-1">
          <p class="bb-done-title">Thanks, that’s with Alex.</p>
          <p>You’ll get a personal reply.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bs-next" aria-labelledby="bs-next-h">
    <div class="bs-wrap bs-next-grid">
      <div data-reveal>
        <h2 id="bs-next-h" class="bs-h2">What happens next</h2>
        <p class="bs-two-tone bs-next-lead">One person handles your search from the first call. <span>The person who reads your brief makes the approaches and writes the briefings.</span></p>
      </div>
      <div class="bs-next-stack" data-reveal style="--d:1">
        <div class="bs-app" data-ui data-reveal style="--d:1">
          <div class="bs-app-bar"><span class="bs-app-title">After you send a brief</span><span class="bs-app-tag">Timeline</span></div>
          <dl class="bs-app-note bs-mini-note">
            {nextSteps.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
        </div>
        <div class="bs-app bs-mini" data-ui data-reveal style="--d:2">
          <div class="bs-app-bar"><span class="bs-app-title">{exampleReply.title}</span></div>
          <dl class="bs-app-note bs-mini-note bs-mini-meta">
            {exampleReply.meta.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
          <div class="bs-mini-body"><p>{exampleReply.body}</p><p class="bs-mini-from">{exampleReply.from}</p></div>
        </div>
        <div class="bs-app" data-ui data-reveal style="--d:3">
          <div class="bs-app-bar"><span class="bs-app-title">{briefings[0].id}, {briefings[0].title}</span></div>
          <dl class="bs-app-note bs-mini-note">
            {briefings[0].glance.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
            <div><dt>Alex’s view</dt><dd>{briefings[0].view}</dd></div>
          </dl>
        </div>
      </div>
    </div>
    <div class="bs-rows">
      <a class="bs-row" href={`mailto:${contact.email}`} data-reveal><span>{contact.email}</span></a>
      <a class="bs-row" href={contact.linkedin} target="_blank" rel="noopener" data-reveal style="--d:1"><span>LinkedIn</span></a>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const done = document.getElementById('contact-done') as HTMLElement | null;
  if (form && done) {
    const status = form.querySelector('.bb-status') as HTMLElement;
    const fields = ['name', 'email', 'company', 'role', 'message'];
    const val = (n: string) => ((form.elements.namedItem(n) as HTMLInputElement)?.value || '').trim();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      const missing = fields.filter((n) => !val(n) || (n === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val(n))));
      if (missing.length) {
        missing.forEach((n) => (form.elements.namedItem(n) as HTMLInputElement).setAttribute('aria-invalid', 'true'));
        (form.elements.namedItem(missing[0]) as HTMLInputElement).focus();
        status.textContent = 'Please fill in the highlighted fields.';
        return;
      }
      const btn = form.querySelector('.bb-send') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Sending';
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...Object.fromEntries(fields.map((f) => [f, val(f)])), website: val('website') }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) throw new Error('send');
        // @ts-ignore gtag comes from the layout
        if (typeof window.gtag === 'function') window.gtag('event', 'generate_lead', { from: 'contact_form' });
        form.hidden = true;
        done.hidden = false;
        done.focus();
      } catch {
        btn.disabled = false;
        btn.textContent = 'Send the brief';
        status.textContent = 'That did not send. Please try again, or email alex@bolt-search.com.';
      }
    });
  }
</script>
