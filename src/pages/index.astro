---
import Layout from '../layouts/Layout.astro';

const title = "Commercial and technical hires for growth companies";
const description = "Bolt Search recruits the sales, solutions and commercial people growth companies cannot afford to get wrong. Current focus: on-site power and data centre infrastructure, and first UK hires for US startups.";

const focus = [
  {
    heading: "On-site power and data centre infrastructure",
    body: "Grid connections at the main data centre hubs can take years, so developers are turning to on-site generation and batteries. The firms building that capacity need people who can sell it and price it.",
    roles: "Business development managers, estimators, proposals and sales engineers from generation, BESS and grid backgrounds.",
  },
  {
    heading: "First UK and EMEA hires for US startups",
    body: "Your first hire outside the US sets the tone for the region. It needs someone who can work without a local team around them and has sold or delivered to UK and European buyers before.",
    roles: "Founding account executives, solutions engineers and implementation leads.",
  },
];

const roles = [
  "Business development and account management",
  "Account executives, including founding AEs",
  "Solutions, sales and proposals engineers",
  "Estimators and bid managers",
  "Implementation and customer success leads",
  "Heads of sales, CROs and CCOs",
];

const steps = [
  {
    heading: "A proper brief",
    body: "A 30-minute call on what the person has to achieve in their first year, not only what the job description says.",
  },
  {
    heading: "A mapped market",
    body: "We map the companies and people who have done this work before. AI-assisted research means we cover a market quickly. Every approach is still made by a person.",
  },
  {
    heading: "A short list you can act on",
    body: "You meet a small number of people we have spoken to, each with a note on why they fit, what they earn and what would move them.",
  },
  {
    heading: "Through to start date",
    body: "We run interviews, feedback, offer and notice period, and stay in touch through the first months.",
  },
];
---

<Layout title={title} description={description}>
  <section class="hero">
    <div class="container-wide">
      <h1>The commercial and technical hires you can't afford to get wrong.</h1>
      <p class="lede">
        Bolt Search finds sales, solutions and commercial people for growth companies: the hires who carry a revenue number or win the technical sale.
      </p>
      <div class="hero-actions">
        <a href="/contact/" class="btn btn-primary">Tell us about the role</a>
        <a href="#how" class="btn btn-outline">How a search runs</a>
      </div>

      <ul class="proof" aria-label="Track record">
        <li><strong>10+ years</strong> recruiting commercial and leadership roles</li>
        <li><strong>CRO, CCO, account director and BD</strong> placements</li>
        <li><strong>Founder-led</strong>: every search run by Alex Lockey</li>
      </ul>
    </div>
  </section>

  <section class="section section-subtle">
    <div class="container-wide">
      <h2 class="section-heading">Where we are working now</h2>
      <div class="grid-2">
        {focus.map((f) => (
          <article class="focus-card">
            <h3>{f.heading}</h3>
            <p>{f.body}</p>
            <p class="focus-roles"><strong>Typical hires:</strong> {f.roles}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-wide roles-wrap">
      <div>
        <h2>The roles we fill</h2>
        <p>Mid-level to leadership hires in sales, solutions and commercial teams, wherever the market is.</p>
      </div>
      <ul class="roles">
        {roles.map((r) => <li>{r}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section-subtle" id="how">
    <div class="container-wide">
      <h2 class="section-heading">How a search runs</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li>
            <h3>{s.heading}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container-wide closing">
      <h2>Hiring for a role like this?</h2>
      <p>Tell us what the role has to achieve. Alex reads and replies to every brief personally.</p>
      <a href="/contact/" class="btn btn-white">Tell us about the role</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: var(--space-4xl) 0 var(--space-3xl);
  }

  .hero h1 {
    max-width: 18ch;
    margin-bottom: var(--space-lg);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
  }

  .proof {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-3xl);
  }

  .proof li {
    background: var(--color-bg-subtle);
    border-radius: 10px;
    padding: var(--space-lg);
    color: var(--color-fg-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .proof strong {
    display: block;
    color: var(--color-fg);
    font-family: var(--font-display);
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .section-heading {
    margin-bottom: var(--space-2xl);
  }

  .focus-card {
    background: var(--color-white);
    border-radius: 12px;
    padding: var(--space-xl);
  }

  .focus-card h3 {
    margin-bottom: var(--space-md);
  }

  .focus-roles {
    margin-bottom: 0;
    color: var(--color-fg);
  }

  .roles-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: var(--space-2xl);
    align-items: start;
  }

  .roles-wrap h2 {
    margin-bottom: var(--space-md);
  }

  .roles {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
  }

  .roles li {
    background: var(--color-accent-light);
    color: var(--color-navy);
    border-radius: 8px;
    padding: var(--space-md) var(--space-lg);
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .steps h3 {
    margin-bottom: var(--space-sm);
  }

  .steps p {
    margin-bottom: 0;
  }

  .closing {
    max-width: 44rem;
  }

  .closing h2 {
    margin-bottom: var(--space-md);
  }

  .closing p {
    margin-bottom: var(--space-xl);
  }

  @media (max-width: 900px) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .roles-wrap { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .hero { padding: var(--space-3xl) 0 var(--space-2xl); }
    .proof, .roles, .steps { grid-template-columns: 1fr; }
  }
</style>
