---
// Home. The market narrows to one person: a short centred hero, the narrowing straight under it,
// the method as one five-stop timeline, a working shortlist, the record, three voices, the brief.
import Layout from '../layouts/Layout.astro';
import Narrowing from '../components/Narrowing.astro';
import Timeline from '../components/Timeline.astro';
import BriefBuilder from '../components/BriefBuilder.astro';
import Shortlist from '../components/Shortlist.astro';
import { hero, heroFacts, founderLine, narrowing, steps, notePitch, facts, placements, quotes, contact } from '../data/site';

const title = 'Commercial and technical hires for growth companies';
const description = 'Bolt Search finds the commercial and technical people growth companies depend on. One recruiter runs each search and sends a full briefing on each shortlisted name.';
---

<Layout title={title} description={description}>
  <section class="bs-hero" aria-labelledby="bs-title">
    <div class="bs-wrap bs-hero-in">
      <h1 id="bs-title" class="bs-h1 bs-lines">
        <span class="bs-line"><span data-line style="--i:0">Hires that carry</span></span>
        <span class="bs-line"><span data-line style="--i:1">a number.</span></span>
      </h1>
      <p class="bs-hero-support" data-after>{hero.support}</p>
      <div class="bs-hero-actions" data-after>
        <a href="#brief" class="bs-btn bs-btn-ink">{hero.action.label}</a>
      </div>
      <ul class="bs-hero-facts" data-after>
        {heroFacts.map(([pre, num, post]) => <li>{pre && `${pre} `}<strong>{num}</strong>{post && ` ${post}`}</li>)}
      </ul>
    </div>
  </section>

  <section class="bs-narrow" id="method" aria-labelledby="bs-narrow-h">
    <div class="bs-wrap bs-split bs-narrow-head">
      <h2 id="bs-narrow-h" class="bs-h2" data-reveal>{narrowing.heading}</h2>
      <p class="bs-two-tone" data-reveal style="--d:1">{narrowing.lead} <span>{narrowing.rest}</span></p>
    </div>
    <Narrowing />
  </section>

  <section class="bs-steps" aria-labelledby="bs-steps-h">
    <div class="bs-wrap">
      <h2 id="bs-steps-h" class="bs-h2 bs-steps-h" data-reveal>{steps.heading}</h2>
      <Timeline />
    </div>
  </section>

  <section class="bs-note" aria-labelledby="bs-note-h">
    <div class="bs-wrap bs-split">
      <h2 id="bs-note-h" class="bs-h2" data-reveal>{notePitch.heading}</h2>
      <p class="bs-two-tone" data-reveal style="--d:1">{notePitch.lead} <span>{notePitch.rest}</span></p>
    </div>
    <div class="bs-wrap bs-note-app" data-reveal style="--d:2">
      <Shortlist />
    </div>
  </section>

  <section class="bs-record" id="record" aria-labelledby="bs-record-h">
    <div class="bs-wrap bs-record-grid">
      <div>
        <h2 id="bs-record-h" class="bs-h2" data-reveal>Track record</h2>
        <dl class="bs-figures bs-figures-gap" data-reveal>
          {facts.slice(0, 3).map((f) => <div><dt>{f.figure}</dt><dd>{f.label}</dd></div>)}
        </dl>
      </div>
      <div class="bs-log" data-ui data-reveal style="--d:1">
        <div class="bs-app-bar"><span class="bs-app-title">Example appointments</span></div>
        <ul>
          {placements.map((p, k) => (
            <li style={`--k:${k}`}>
              <span class="bs-log-check" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="16" height="16"><circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5" /><polyline points="5,8.2 7.2,10.3 11,6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
              </span>
              <span class="bs-log-role">{p.role}</span>
              <span class="bs-log-co">{p.company}</span>
              <span class="bs-log-year">{p.year}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="bs-letter" aria-labelledby="bs-letter-h">
    <div class="bs-wrap bs-voices">
      <h2 id="bs-letter-h" class="bs-h2" data-reveal>In their words</h2>
      <div class="bs-voice-list">
        {[quotes[1], quotes[3], quotes[0]].map((q, i) => (
          <blockquote data-reveal style={`--d:${i}`}>
            <p>{q.text}</p>
            <footer>{q.who}</footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="bs-alex" id="alex" aria-labelledby="bs-alex-h">
    <div class="bs-wrap bs-alex-in" data-reveal>
      <img src="/images/alex-headshot-600.webp" alt="Alex Lockey" width="600" height="804" loading="lazy" />
      <div>
        <h2 id="bs-alex-h" class="bs-h2">Alex Lockey</h2>
        <blockquote class="bs-alex-quote">“{founderLine}”</blockquote>
        <p class="bs-two-tone bs-alex-sub"><span>Recruiting since 2007, founder since 2016, trained as an engineer.</span></p>
        <a href="/about/" class="bs-hero-link bs-alex-link">More about Alex</a>
      </div>
    </div>
  </section>

  <section class="bs-contact" id="brief" aria-labelledby="bs-contact-h">
    <div class="bs-wrap bs-contact-grid">
      <div class="bs-contact-copy" data-reveal>
        <h2 id="bs-contact-h" class="bs-h2">Tell us about the role</h2>
        <p class="bs-two-tone">Fill in the sentence. <span>Alex replies personally.</span></p>
      </div>
      <div class="bs-composer" data-ui data-reveal style="--d:1">
        <div class="bs-app-bar"><span class="bs-app-title">New brief</span><span class="bs-app-tag">To Alex Lockey</span></div>
        <BriefBuilder />
      </div>
    </div>
    <div class="bs-rows">
      <a class="bs-row" href={`mailto:${contact.email}`}><span>{contact.email}</span></a>
    </div>
  </section>
</Layout>
