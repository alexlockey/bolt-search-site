---
// Home. Idea: the market narrows to one person. Type carries the first screen, one diagram tells the
// method, and the search's own working documents (slip, shortlist, log, the brief) are the pictures.
import Layout from '../layouts/Layout.astro';
import Narrowing from '../components/Narrowing.astro';
import BriefBuilder from '../components/BriefBuilder.astro';
import Shortlist from '../components/Shortlist.astro';
import { hero, narrowing, slip, notePitch, facts, placements, placedRoles, quotes, contact } from '../data/site';

const title = 'Commercial and technical hires for growth companies';
const description = 'Bolt Search finds the commercial and technical people growth companies depend on. One recruiter runs every search, with a written note on every name.';
---

<Layout title={title} description={description}>
  <section class="bs-hero" aria-labelledby="bs-title">
    <div class="bs-hero-ink">
      <h1 id="bs-title" class="bs-h1 bs-lines">
        <span class="bs-line"><span data-line style="--i:0">Hires that carry</span></span>
        <span class="bs-line"><span data-line style="--i:1">the number.</span></span>
      </h1>
    </div>
    <div class="bs-hero-paper">
      <p class="bs-hero-support" data-after>{hero.support}</p>
      <div class="bs-hero-actions" data-after>
        <a href="#brief" class="bs-btn bs-btn-dark">{hero.action.label}</a>
        <a href={hero.second.href} class="bs-hero-link">{hero.second.label}</a>
      </div>
    </div>
  </section>

  <section class="bs-narrow" id="method" aria-labelledby="bs-narrow-h">
    <div class="bs-wrap bs-split">
      <h2 id="bs-narrow-h" class="bs-h2" data-reveal>{narrowing.heading}</h2>
      <p class="bs-two-tone" data-reveal style="--d:1">{narrowing.lead} <span>{narrowing.rest}</span></p>
    </div>
    <Narrowing />
  </section>

  <section class="bs-runs" aria-labelledby="bs-runs-h">
    <div class="bs-wrap bs-runs-grid">
      <div class="bs-runs-copy" data-reveal>
        <h2 id="bs-runs-h" class="bs-h2">How a search runs</h2>
        <p class="bs-lead">{slip.lead}</p>
        <p class="bs-body">Thirty minutes on what the first year has to achieve, what has not worked before, and who the person reports to. Then Alex does the rest himself.</p>
      </div>
      <div class="bs-slip" data-ui data-reveal style="--d:1">
        <p class="bs-slip-title">{slip.title}</p>
        {slip.groups.map((g, k) => (
          <div class="bs-slip-group" style={`--k:${k}`}>
            <p class="bs-slip-head">{g.group}</p>
            {g.rows.map(([what, who]) => (
              <p class="bs-slip-row"><span>{what}</span><span class="bs-leader" aria-hidden="true"></span><span>{who}</span></p>
            ))}
          </div>
        ))}
        <p class="bs-slip-total"><span>{slip.total[0]}</span><span>{slip.total[1]}</span></p>
      </div>
    </div>
  </section>

  <section class="bs-note" aria-labelledby="bs-note-h">
    <div class="bs-wrap bs-split">
      <h2 id="bs-note-h" class="bs-h2" data-reveal>{notePitch.heading}</h2>
      <p class="bs-two-tone" data-reveal style="--d:1">{notePitch.lead} <span>{notePitch.rest}</span></p>
    </div>
    <div class="bs-wrap bs-note-app" data-reveal style="--d:2">
      <Shortlist />
    </div>
  </section>

  <section class="bs-record" id="record" aria-labelledby="bs-record-h">
    <div class="bs-wrap">
      <div class="bs-names" data-names>
        <h2 id="bs-record-h" class="bs-names-h">Placed so far:</h2>
        {placedRoles.map((n, i) => <span class={`bs-name${i === 0 ? ' is-lit' : ''}`}>{n}{i < placedRoles.length - 1 ? ', ' : '.'}</span>)}
      </div>
      <div class="bs-record-grid">
        <dl class="bs-figures" data-reveal>
          {facts.slice(0, 3).map((f) => <div><dt>{f.figure}</dt><dd>{f.label}</dd></div>)}
        </dl>
        <div class="bs-log" data-ui data-reveal style="--d:1">
          <div class="bs-app-bar"><span class="bs-app-title">Placement log</span><span class="bs-app-tag">Roles only, no names</span></div>
          <ul>
            {placements.map((p, k) => (
              <li style={`--k:${k}`}>
                <span class="bs-log-check" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="16" height="16"><circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5" /><polyline points="5,8.2 7.2,10.3 11,6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
                </span>
                <span class="bs-log-role">{p.role}</span>
                <span class="bs-log-co">{p.company}</span>
                <span class="bs-log-year">{p.year}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bs-letter" aria-labelledby="bs-letter-h">
    <div class="bs-wrap bs-letter-grid">
      <h2 id="bs-letter-h" class="bs-h2" data-reveal>In their words</h2>
      <div class="bs-letter-body">
        <blockquote class="bs-letter-open" data-reveal>
          <p>{quotes[0].text}</p>
          <footer>{quotes[0].who}</footer>
        </blockquote>
        {quotes.slice(1).map((q, i) => (
          <blockquote data-reveal style={`--d:${i % 2}`}>
            <p>{q.text}</p>
            <footer>{q.who}</footer>
          </blockquote>
        ))}
        <p class="bs-letter-sign">Paraphrased from fifteen LinkedIn recommendations. <a href={hero.second.href}>Ask to speak to a reference</a>.</p>
      </div>
    </div>
  </section>

  <section class="bs-about" id="alex" aria-labelledby="bs-about-h">
    <div class="bs-wrap">
      <h2 id="bs-about-h" class="bs-h2 bs-about-h" data-reveal>Alex Lockey</h2>
      <div class="bs-about-text" data-reveal>
        <div class="bs-para">
          Alex has recruited since <mark class="hl-a">2007</mark> and founded Bolt Search in <mark class="hl-a">2016</mark>. He runs <mark class="hl-b">every search himself</mark>: the brief, the map, every call, the shortlist notes and the check-in after the start date.
        </div>
        <div class="bs-para">
          He trained as an <mark class="hl-b">engineer</mark>, with a BEng in Aeronautical Engineering from the <mark class="hl-c">University of Bristol</mark>, which helps when a hire has to hold a technical conversation with a buyer as well as a commercial one. <a href="/about/" class="hl-go">More about Alex and how he works.</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bs-contact" id="brief" aria-labelledby="bs-contact-h">
    <div class="bs-wrap bs-contact-grid">
      <div class="bs-contact-copy" data-reveal>
        <h2 id="bs-contact-h" class="bs-h2">Tell us about the role</h2>
        <p class="bs-two-tone">Fill in the sentence. <span>It becomes your brief, and Alex replies personally.</span></p>
        <p class="bs-body bs-contact-note">References from past clients and placed candidates are available on request.</p>
      </div>
      <div class="bs-composer" data-ui data-reveal style="--d:1">
        <div class="bs-app-bar"><span class="bs-app-title">New brief</span><span class="bs-app-tag">To Alex Lockey</span></div>
        <BriefBuilder />
      </div>
    </div>
    <div class="bs-rows">
      <a class="bs-row" href={`mailto:${contact.email}`}><span>{contact.email}</span></a>
      <a class="bs-row" href={contact.linkedin} target="_blank" rel="noopener"><span>LinkedIn</span></a>
      <p class="bs-row"><span>UK-based, UK and US clients</span></p>
    </div>
  </section>
</Layout>
