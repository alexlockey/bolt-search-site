---
// Concept E, the quiet instrument (round 3). Linear-weighted, with Visualize Value diagrams.
// Idea: the search narrows a market of hollow circles to the filled few you meet, and its working
// documents (brief, map, approach log, shortlist note, close) are the page's pictures.
import '@fontsource-variable/inter';
import BriefBuilder from '../BriefBuilder.astro';
import { hero, navLinks, method, shortlistNote, facts, placements, roles, quotes, about, brief, contact } from '../../data/site';

// Illustrative searches for the hero instrument. Counts narrow in order and are labelled as examples.
const searches = [
  { id: 'ae', label: 'Founding AE', role: 'founding account executive', counts: [214, 61, 27, 12, 4] },
  { id: 'se', label: 'Solutions engineer', role: 'solutions engineer', counts: [168, 44, 22, 10, 4] },
  { id: 'hos', label: 'Head of sales', role: 'head of sales', counts: [126, 38, 19, 9, 3] },
  { id: 'bdm', label: 'BD manager', role: 'business development manager', counts: [240, 72, 30, 14, 5] },
];
const stageNames = ['Mapped', 'Matched', 'Approached', 'Spoken to', 'Shortlisted'];

// A fixed 24 x 10 field of circles. Rank decides how far each one gets; a seeded shuffle spreads the
// few that reach the shortlist across the field instead of bunching them.
const COLS = 24;
const ROWS = 10;
const N = COLS * ROWS;
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const order = Array.from({ length: N }, (_, i) => i);
for (let i = N - 1; i > 0; i--) {
  const j = Math.floor(rand() * (i + 1));
  [order[i], order[j]] = [order[j], order[i]];
}
const rank: number[] = new Array(N);
order.forEach((cell, r) => (rank[cell] = r));
const dots = Array.from({ length: N }, (_, i) => ({ x: 14 + (i % COLS) * 17, y: 14 + Math.floor(i / COLS) * 17, r: rank[i] }));
const stateFor = (r: number, c: number[]) => (r < c[4] ? 's4' : r < c[3] ? 's3' : r < c[2] ? 's2' : r < c[1] ? 's1' : r < c[0] ? 's0' : 'sx');
const first = searches[0];

const stageCopy = method.stages;
const half = Math.ceil(placements.length / 2);
const [lead, ...replies] = [quotes[1], quotes[2], quotes[3]];
const dates = ['3 Jun 2021', '9 Dec 2025', '25 Apr 2024'];
---

<div class="qi">
  <section class="qi-hero" aria-labelledby="qi-title">
    <header class="qi-word"><a href="/">Bolt Search</a></header>

    <div class="qi-hero-text" data-qi-in>
      <h1 id="qi-title">Hires that carry the number.</h1>
      <p>{hero.support}</p>
      <div class="qi-actions">
        <a class="qi-btn" href={hero.action.href}>{hero.action.label}</a>
        <a class="qi-text-link" href={hero.second.href}>{hero.second.label}</a>
      </div>
    </div>

    <div class="qi-right">
      <nav class="qi-nav" aria-label="Main">
        {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href="#brief" class="qi-nav-cta">Send a brief</a>
      </nav>

      <div class="qi-tool" data-ui data-searches={JSON.stringify(searches)}>
        <div class="qi-tool-head">
          <p class="qi-tool-title">Example search: <span data-tool-role>{first.label}</span></p>
          <p class="qi-tool-tag">Illustrative</p>
        </div>
        <div class="qi-seg" role="group" aria-label="Choose a role to see an example search">
          {searches.map((s, i) => (
            <button type="button" data-search={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>{s.label}</button>
          ))}
        </div>
        <svg class="qi-field" viewBox="0 0 414 182" role="img" aria-label="A market of people narrowing to a shortlist">
          {dots.map((d) => (
            <circle cx={d.x} cy={d.y} r="3.4" class={stateFor(d.r, first.counts)} data-rank={d.r} />
          ))}
        </svg>
        <ol class="qi-counts">
          {stageNames.map((n, i) => (
            <li class={i === 4 ? 'is-last' : ''}>
              <span class="qi-key"><i class={`k${i}`} aria-hidden="true"></i>{n}</span>
              <span class="qi-num" data-count={i}>{first.counts[i]}</span>
            </li>
          ))}
        </ol>
        <button type="button" class="qi-use">Start a brief for this role</button>
      </div>
    </div>
  </section>

  <section class="qi-method" id="method" aria-labelledby="qi-method-h">
    <div class="qi-wrap">
      <header class="qi-method-head">
        <h2 id="qi-method-h">{method.heading}</h2>
        <p>{method.note}</p>
      </header>

      <div class="qi-steps">
        {stageCopy.map((s, i) => (
          <div class="qi-row">
            <div class="qi-step" data-step={i}>
              <h3>{s.line}</h3>
              <p>{s.body}</p>
            </div>
            <div class="qi-frame" data-frame={i}>
              {i === 0 && (
                <div class="qi-doc" data-ui>
                  <div class="qi-doc-head">
                    <p class="qi-doc-title">Brief: Founding Account Executive, UK</p>
                    <p class="qi-doc-sub">Series B software company, US headquarters</p>
                  </div>
                  <dl>
                    <div><dt>Year one</dt><dd>Open the UK: first ten customers and a repeatable mid-market motion</dd></div>
                    <div><dt>Reports to</dt><dd>VP Sales, US, eight hours behind</dd></div>
                    <div><dt>Must have</dt><dd>Sold a technical product to UK buyers, alone, from first call to contract</dd></div>
                    <div><dt>Will not work</dt><dd>Sellers who have always had SDRs, SEs and a brand behind them</dd></div>
                  </dl>
                  <p class="qi-doc-foot"><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" /><path d="M5 8.2l2 2 4-4.4" /></svg>Agreed on the first call</p>
                </div>
              )}
              {i === 1 && (
                <div class="qi-doc" data-ui>
                  <div class="qi-doc-head">
                    <p class="qi-doc-title">Market map</p>
                    <p class="qi-doc-sub">38 comparable companies, 214 people</p>
                  </div>
                  <div class="qi-chips"><span>Sold alone</span><span>UK buyers</span><span>Six-figure deals</span></div>
                  <table>
                    <thead><tr><th scope="col">Company type</th><th scope="col">People</th><th scope="col">Fit</th></tr></thead>
                    <tbody>
                      <tr><td>Series B data platforms, London</td><td>41</td><td>14</td></tr>
                      <tr><td>Vertical software, financial services</td><td>36</td><td>12</td></tr>
                      <tr><td>Developer tools, UK teams</td><td>29</td><td>9</td></tr>
                      <tr><td>Payments infrastructure</td><td>33</td><td>8</td></tr>
                      <tr><td>Security software</td><td>27</td><td>7</td></tr>
                      <tr><td>Other, 33 companies</td><td>48</td><td>11</td></tr>
                    </tbody>
                  </table>
                  <p class="qi-doc-foot">Example: no real companies or people</p>
                </div>
              )}
              {i === 2 && (
                <div class="qi-doc" data-ui>
                  <div class="qi-doc-head">
                    <p class="qi-doc-title">Approaches this week</p>
                    <p class="qi-doc-sub">Made by Alex, by phone and message</p>
                  </div>
                  <svg class="qi-orbit" viewBox="0 0 300 120" aria-hidden="true">
                    <circle cx="150" cy="60" r="44" class="qi-dash" />
                    <circle cx="150" cy="60" r="6" class="qi-solid" />
                    <circle cx="136" cy="40" r="4" /><circle cx="168" cy="72" r="4" />
                    <circle cx="52" cy="34" r="4" /><circle cx="250" cy="28" r="4" /><circle cx="262" cy="92" r="4" /><circle cx="40" cy="96" r="4" />
                    <path d="M144 57 L60 36" /><path d="M156 57 L242 30" /><path d="M156 63 L254 90" /><path d="M144 63 L48 94" />
                  </svg>
                  <ul class="qi-log">
                    <li><span>Candidate A</span><span>Not looking</span><span>Call booked</span></li>
                    <li><span>Candidate B</span><span>Not looking</span><span>Spoken to</span></li>
                    <li><span>Candidate C</span><span>Looking</span><span>Wrong stage</span></li>
                    <li><span>Candidate D</span><span>Not looking</span><span>Call booked</span></li>
                  </ul>
                </div>
              )}
              {i === 3 && (
                <div class="qi-doc qi-note" data-ui>
                  <div class="qi-doc-head">
                    <p class="qi-doc-title">{shortlistNote.candidate}</p>
                    <p class="qi-doc-sub">{shortlistNote.label}, no real person</p>
                  </div>
                  <dl>
                    {shortlistNote.rows.map(([k, v]) => <div class="qi-line"><dt>{k}</dt><dd>{v}</dd></div>)}
                  </dl>
                </div>
              )}
              {i === 4 && (
                <div class="qi-doc" data-ui>
                  <div class="qi-doc-head">
                    <p class="qi-doc-title">From offer to the seat</p>
                    <p class="qi-doc-sub">Example timeline</p>
                  </div>
                  <ol class="qi-time">
                    <li class="is-done"><span>Offer accepted</span><span>Week 0</span></li>
                    <li class="is-done"><span>Notice period, kept in touch</span><span>Weeks 1 to 4</span></li>
                    <li class="is-done"><span>First day</span><span>Week 5</span></li>
                    <li><span>Check-in with you and the hire</span><span>After the start</span></li>
                  </ol>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="qi-record" id="record" aria-labelledby="qi-record-h">
    <div class="qi-wrap qi-record-row" data-qi-in>
      <h2 id="qi-record-h">Track record</h2>
      <dl class="qi-facts">
        {facts.map((f) => (
          <div><dt>{f.figure}</dt><dd>{f.label}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="qi-say" aria-labelledby="qi-say-h">
    <div class="qi-wrap">
      <h2 id="qi-say-h">What clients and candidates say</h2>
      <article class="qi-comment qi-comment-lead" data-ui data-qi-in>
        <p class="qi-comment-meta"><span class="qi-disc" aria-hidden="true"></span><span class="qi-who">{lead.who}</span><span class="qi-date">{dates[0]}</span></p>
        <p class="qi-comment-body">{lead.text}</p>
        <p class="qi-comment-state">Recommendation on LinkedIn, paraphrased</p>
      </article>
      <div class="qi-replies">
        {replies.map((q, i) => (
          <article class="qi-comment" data-ui data-qi-in>
            <p class="qi-comment-meta"><span class="qi-disc qi-disc-small" aria-hidden="true"></span><span class="qi-who">{q.who}</span><span class="qi-date">{dates[i + 1]}</span></p>
            <p class="qi-comment-body">{q.text}</p>
          </article>
        ))}
      </div>
      <p class="qi-more" data-qi-in>Fifteen recommendations in all. <a href={hero.second.href}>Ask to speak to a reference</a></p>
    </div>
  </section>

  <section class="qi-about" id="alex" aria-labelledby="qi-about-h">
    <div class="qi-wrap">
      <div class="qi-about-row" data-qi-in>
        <dl class="qi-side">
          {about.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
        <div class="qi-about-text">
          <h2 id="qi-about-h">{about.heading}</h2>
          {about.body.map((t) => <p>{t}</p>)}
        </div>
      </div>
      <div class="qi-about-row qi-lists" data-qi-in>
        <p class="qi-side-word">Record</p>
        <div class="qi-cols">
          <div>
            <h3>Recent placements</h3>
            <ul>
              {placements.map((p) => <li><span>{p.role}</span><span>{p.year}</span></li>)}
            </ul>
          </div>
          <div>
            <h3>Roles we fill</h3>
            <ul>
              {roles.map((r) => <li><span>{r}</span></li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="qi-contact" id="brief" aria-labelledby="qi-brief-h">
    <div class="qi-wrap qi-contact-row">
      <div class="qi-contact-main" data-qi-in>
        <h2 id="qi-brief-h">{brief.heading}</h2>
        <p class="qi-lead">{brief.lead}</p>
        <BriefBuilder />
      </div>
      <aside class="qi-contact-side" data-qi-in>
        <img src="/images/alex-headshot-600.webp" alt="Alex Lockey" width="160" height="214" loading="lazy" />
        <div>
          <p class="qi-q">Rather email?</p>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
          <a href={contact.linkedin} target="_blank" rel="noopener">Alex on LinkedIn</a>
          <p class="qi-small">{contact.where} {contact.reply}</p>
          <p class="qi-small">{brief.after}</p>
        </div>
      </aside>
    </div>
  </section>

  <footer class="qi-foot">
    <p>Bolt Search, commercial and technical hires</p>
    <nav aria-label="Footer">
      {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href={about.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    </nav>
    <p class="qi-foot-r">&copy; {new Date().getFullYear()} Bolt Search</p>
  </footer>
</div>

<style>
  :global(body:has(.qi)) {
    margin: 0;
    background: #08090A;
  }

  .qi {
    --bg: #08090A;
    --panel: #0F1011;
    --raised: #16171A;
    --line: #23252A;
    --ink: #F7F8F8;
    --muted: #8A8F98;
    --soft: #62666D;
    --accent: #009EE2;
    --m: clamp(20px, 3vw, 40px);
    --inset: max(var(--m), calc((100cqw - 1200px) / 2 + var(--m)));
    --body: #C9CCD3;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    container-type: inline-size;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Inter Variable', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 17px;
    line-height: 1.55;
    font-feature-settings: 'cv11', 'ss03';
    -webkit-font-smoothing: antialiased;
  }

  .qi :global(*) {
    box-sizing: border-box;
  }

  .qi h1, .qi h2, .qi h3, .qi p, .qi dl, .qi dd, .qi ul, .qi ol, .qi figure {
    margin: 0;
    padding: 0;
  }

  .qi ul, .qi ol {
    list-style: none;
  }

  .qi a {
    color: var(--ink);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .qi a:focus-visible, .qi button:focus-visible, .qi :global(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .qi h1, .qi h2, .qi h3 {
    font-weight: 540;
    letter-spacing: -0.022em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .qi-wrap {
    padding: 0 var(--inset);
  }

  /* Buttons and links */
  .qi a.qi-btn, .qi-use, .qi :global(.bb-send) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 18px;
    border: 0;
    border-radius: 8px;
    background: var(--ink);
    color: var(--bg);
    font: inherit;
    font-size: 15px;
    font-weight: 540;
    cursor: pointer;
    transition: background-color 180ms ease, transform 140ms var(--ease);
  }

  .qi a.qi-btn:hover, .qi-use:hover, .qi :global(.bb-send:hover) {
    background: #FFFFFF;
    color: var(--bg);
  }

  .qi-btn:active, .qi-use:active, .qi :global(.bb-send:active) {
    transform: scale(0.97);
  }

  .qi-text-link {
    color: var(--muted) !important;
    font-size: 15px;
  }

  .qi-text-link:hover {
    color: var(--ink) !important;
  }

  /* Hero: two tones meeting at the centre */
  .qi-hero {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto 1fr auto;
    min-height: calc(100svh - 36px);
  }

  .qi-word {
    grid-column: 1;
    grid-row: 1;
    padding: 28px var(--m) 0 var(--inset);
    font-size: 17px;
    font-weight: 560;
    letter-spacing: -0.01em;
    z-index: 2;
  }

  .qi-hero-text {
    grid-column: 1;
    grid-row: 3;
    padding: 0 var(--m) clamp(40px, 7vh, 72px) var(--inset);
  }

  .qi-hero-text h1 {
    font-size: clamp(40px, 4.4vw, 64px);
    line-height: 1.04;
    letter-spacing: -0.03em;
    max-width: 11ch;
    margin-bottom: 24px;
  }

  .qi-hero-text p {
    color: var(--body);
    max-width: 42ch;
    font-size: 17px;
  }

  .qi-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    margin-top: 32px;
  }

  .qi-right {
    grid-column: 2;
    grid-row: 1 / span 3;
    background: var(--panel);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 var(--inset) clamp(32px, 6vh, 56px) var(--m);
  }

  .qi-nav {
    align-self: stretch;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 24px;
    padding-top: 22px;
    font-size: 15px;
  }

  .qi-nav a {
    color: var(--muted);
  }

  .qi-nav a:hover {
    color: var(--ink);
  }

  .qi-nav .qi-nav-cta {
    color: var(--ink);
  }

  /* The instrument */
  .qi-tool[data-ui] {
    margin: auto 0;
    width: min(100%, 470px);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 20px;
    font-size: 14px;
  }

  .qi-tool-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 14px;
  }

  .qi-tool-title {
    font-weight: 540;
    font-size: 15px;
  }

  .qi-tool-tag {
    color: var(--muted);
    font-size: 13px;
  }

  .qi-seg {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
    padding: 2px;
    background: var(--raised);
    border-radius: 8px;
    margin-bottom: 18px;
  }

  .qi-seg button {
    font: inherit;
    font-size: 13px;
    color: var(--muted);
    background: transparent;
    border: 0;
    border-radius: 6px;
    padding: 8px 4px;
    cursor: pointer;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .qi-seg button:hover {
    color: var(--ink);
  }

  .qi-seg button[aria-pressed='true'] {
    background: var(--line);
    color: var(--ink);
  }

  .qi-field {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 16px;
  }

  .qi-field circle {
    fill: transparent;
    stroke: transparent;
    stroke-width: 1.3;
    transition: fill 420ms var(--ease), stroke 420ms var(--ease), r 420ms var(--ease);
  }

  .qi-field .sx { r: 1; fill: var(--line); }
  .qi-field .s0 { r: 1.6; fill: var(--soft); }
  .qi-field .s1 { r: 3.2; stroke: var(--soft); }
  .qi-field .s2 { r: 3.4; stroke: var(--muted); }
  .qi-field .s3 { r: 3.6; stroke: var(--ink); }
  .qi-field .s4 { r: 4.4; fill: var(--ink); stroke: var(--ink); }

  .qi-tool[data-ui] .qi-counts li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 7px 0;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  .qi-counts li.is-last {
    color: var(--ink);
  }

  .qi-key {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .qi-key i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }

  .qi-key .k0 { background: var(--soft); transform: scale(0.5); }
  [data-ui] .qi-key .k1 { border: 1.3px solid var(--soft); }
  [data-ui] .qi-key .k2 { border: 1.3px solid var(--muted); }
  [data-ui] .qi-key .k3 { border: 1.3px solid var(--ink); }
  .qi-key .k4 { background: var(--ink); }

  .qi-num {
    font-variant-numeric: tabular-nums;
    color: inherit;
  }

  .is-last .qi-num {
    color: var(--accent);
    font-weight: 540;
  }

  .qi-use {
    width: 100%;
    margin-top: 16px;
    font-size: 14px;
  }

  /* Method: statements left, the working document right */
  .qi-method {
    padding: clamp(96px, 14vh, 160px) 0 clamp(64px, 10vh, 120px);
  }

  .qi-method-head {
    max-width: 520px;
    margin-bottom: 56px;
  }

  .qi-method-head h2, .qi-say h2, .qi-contact h2 {
    font-size: 32px;
    margin-bottom: 14px;
  }

  .qi-method-head p {
    color: var(--body);
  }

  .qi-row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    column-gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .qi-step {
    min-height: 78vh;
    padding-top: 10vh;
    max-width: 480px;
  }

  .qi-row:first-child .qi-step {
    padding-top: 0;
  }

  .qi-row:last-child .qi-step {
    min-height: 0;
  }

  .qi-step h3 {
    font-size: 32px;
    margin-bottom: 14px;
    transition: color 260ms ease;
  }

  .qi-step p {
    color: var(--body);
    max-width: 40ch;
  }

  .qi-frame {
    position: sticky;
    top: calc(12vh + 24px);
  }

  .qi-row:not(:first-child) .qi-frame {
    margin-top: 10vh;
  }

  .qi-doc[data-ui] {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 22px;
    font-size: 14px;
    line-height: 1.5;
  }

  .qi-doc-head {
    margin-bottom: 18px;
  }

  .qi-doc-title {
    font-size: 15px;
    font-weight: 540;
    letter-spacing: -0.01em;
  }

  .qi-doc-sub {
    color: var(--muted);
    font-size: 14px;
  }

  .qi-doc[data-ui] dl > div {
