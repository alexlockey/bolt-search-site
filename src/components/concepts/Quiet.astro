</style>

<script>
  const root = document.querySelector('.qi') as HTMLElement | null;
  if (root) {
    document.documentElement.classList.add('qi-js');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // The instrument: pick a role, the market narrows to its shortlist.
    const tool = root.querySelector('.qi-tool') as HTMLElement;
    const searches = JSON.parse(tool.dataset.searches || '[]') as { id: string; label: string; role: string; counts: number[] }[];
    const circles = Array.from(tool.querySelectorAll<SVGCircleElement>('.qi-field circle'));
    const nums = Array.from(tool.querySelectorAll<HTMLElement>('[data-count]'));
    const roleText = tool.querySelector('[data-tool-role]') as HTMLElement;
    let current = searches[0];

    const stateFor = (r: number, c: number[]) => (r < c[4] ? 's4' : r < c[3] ? 's3' : r < c[2] ? 's2' : r < c[1] ? 's1' : r < c[0] ? 's0' : 'sx');

    const tick = (el: HTMLElement, to: number) => {
      const from = Number(el.textContent) || 0;
      if (reduce || from === to) {
        el.textContent = String(to);
        return;
      }
      const t0 = performance.now();
      const step = (t: number) => {
        const k = Math.min(1, (t - t0) / 420);
        const e = 1 - Math.pow(1 - k, 3);
        el.textContent = String(Math.round(from + (to - from) * e));
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
      // Land on the true figure even if frames are throttled.
      setTimeout(() => (el.textContent = String(to)), 480);
    };

    const apply = (s: typeof current) => {
      current = s;
      roleText.textContent = s.label;
      circles.forEach((c) => c.setAttribute('class', stateFor(Number(c.dataset.rank), s.counts)));
      nums.forEach((n, i) => tick(n, s.counts[i]));
      tool.querySelectorAll<HTMLButtonElement>('[data-search]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.search === s.id)));
    };

    tool.querySelectorAll<HTMLButtonElement>('[data-search]').forEach((b) =>
      b.addEventListener('click', () => {
        const s = searches.find((x) => x.id === b.dataset.search);
        if (s) apply(s);
      })
    );

    // On load the field settles from the whole market to the shortlist, once.
    if (!reduce) {
      circles.forEach((c) => c.setAttribute('class', Number(c.dataset.rank) < current.counts[0] ? 's0' : 'sx'));
      setTimeout(() => apply(current), 350);
    }

    // Hand the chosen role to the brief sentence.
    tool.querySelector('.qi-use')?.addEventListener('click', () => {
      const input = document.querySelector<HTMLInputElement>('#brief-form input[name="role"]');
      if (input) {
        input.value = current.role;
        input.dispatchEvent(new Event('input', { bubbles: true }));
        document.getElementById('brief')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        setTimeout(() => document.querySelector<HTMLInputElement>('#brief-form input[name="where"]')?.focus({ preventScroll: true }), reduce ? 0 : 600);
      }
    });

    // Entrances and the active statement.
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }),
        { rootMargin: '0px 0px -12% 0px' }
      );
      root.querySelectorAll('[data-qi-in]').forEach((el, i) => {
        (el as HTMLElement).style.transitionDelay = `${(i % 3) * 70}ms`;
        io.observe(el);
      });

      const note = root.querySelector('.qi-note');
      const steps = Array.from(root.querySelectorAll<HTMLElement>('.qi-step'));
      const active = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            steps.forEach((s) => s.classList.toggle('is-active', s === e.target));
            if ((e.target as HTMLElement).dataset.step === '3' && note) {
              note.querySelectorAll<HTMLElement>('.qi-line').forEach((l, i) => (l.style.transitionDelay = `${i * 140}ms`));
              note.classList.add('is-filled');
            }
          }),
        { rootMargin: '-42% 0px -42% 0px' }
      );
      steps.forEach((s) => active.observe(s));
      if (note) {
        const fill = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (e.isIntersecting) {
            note.querySelectorAll<HTMLElement>('.qi-line').forEach((l, i) => (l.style.transitionDelay = `${i * 140}ms`));
            note.classList.add('is-filled');
            fill.disconnect();
          }
        }), { threshold: 0.5 });
        fill.observe(note);
      }
      steps[0]?.classList.add('is-active');
    } else {
      root.querySelectorAll('[data-qi-in]').forEach((el) => el.classList.add('is-in'));
      root.querySelector('.qi-note')?.classList.add('is-filled');
    }
  }
</script>
