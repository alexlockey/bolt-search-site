  .snt :global(.bb-slot input[aria-invalid]) { border-bottom-color: var(--accent); }
  .snt :global(.bb-who) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .snt :global(.bb-field) { display: grid; gap: 6px; font-size: 15px; font-weight: 500; }
  .snt :global(.bb-field input) {
