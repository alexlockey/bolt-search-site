  }
  .snt-brief-main { grid-column: 1 / span 8; }
  .snt .snt-brief-lead { font-size: var(--step-lead); line-height: 1.3; max-width: 34rem; margin: 0 0 48px; }
  .snt-brief-side { grid-column: 10 / span 3; display: grid; gap: 20px; align-content: start; padding-top: 8px; }
  .snt-brief-side img { width: 160px; height: 160px; object-fit: cover; object-position: 50% 25%; }
  .snt-brief-side p { font-size: var(--step-body); }
  .snt-q { font-weight: 600; margin-bottom: 12px !important; }
