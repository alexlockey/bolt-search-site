  .snt :global(.bb-field input:focus) { outline: 2px solid var(--accent); outline-offset: 0; border-color: transparent; }
  .snt :global(.bb-field input[aria-invalid]) { border-color: var(--accent); }
  .snt :global(.bb-actions) { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .snt :global(.bb-send) {
    min-height: 52px;
    padding: 0 26px;
    background: var(--accent);
    color: var(--accent-ink);
    font: 500 var(--step-body) / 1 var(--text);
    border: 0;
    cursor: pointer;
    transition: background-color 180ms ease, transform 140ms var(--ease-out);
  }
  .snt :global(.bb-send:hover) { background: var(--accent-press); }
  .snt :global(.bb-send:active) { transform: scale(0.97); }
  .snt :global(.bb-status) { font-size: 15px; color: var(--accent-press); }
  .snt :global(.bb-done) { font-size: var(--step-lead); line-height: 1.35; }
  .snt :global(.bb-done-title) { font-family: var(--display); text-transform: uppercase; font-size: var(--step-head); line-height: 1; margin-bottom: 16px; }

  /* Footer */
  .snt-foot {
    background: var(--accent);
    color: var(--accent-ink);
    min-height: 90svh;
    padding: 40px var(--m) 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 64px;
  }
  .snt-foot-top { display: grid; grid-template-columns: auto minmax(0, 1fr) minmax(0, 1fr) auto; gap: 32px; font-size: 15px; align-items: start; }
  .snt-foot .snt-foot-mark { height: 24px; width: auto; filter: brightness(0) invert(1); }
  .snt-foot-top-link { text-underline-offset: 4px; }
  .snt-mail a {
    display: flex;
    flex-wrap: wrap;
    text-decoration: none;
    font-family: var(--text);
    font-weight: 500;
    font-size: var(--step-display);
    line-height: 0.95;
    letter-spacing: -0.035em;
    transition: opacity 180ms ease;
  }
  .snt-mail a:hover { opacity: 0.85; }
  .snt-foot-meta { display: flex; justify-content: space-between; gap: 16px; font-size: 15px; flex-wrap: wrap; }
  .snt-foot-meta a { text-underline-offset: 3px; }

  /* Tablet */
  @media (max-width: 1024px) {
    .snt-panel { grid-template-columns: 1fr; min-height: 0; }
    .snt-panel-r .snt-panel-pic { order: 0; }
    .snt-panel-pic { min-height: 0; aspect-ratio: 4 / 3; }
    .snt-tone-3 .snt-panel-pic { aspect-ratio: auto; min-height: 0; padding: clamp(20px, 6vw, 72px); }
    .snt-note { position: static; inset: auto; }
    .snt-panel-text { padding: 40px var(--m) 88px; }
    .snt-verb-hold { display: block; }
    .snt-verb { margin-bottom: 24px; }
    .snt-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 56px; }
    .snt-brief-main { grid-column: 1 / -1; }
    .snt-brief-side { grid-column: 1 / -1; grid-template-columns: 160px minmax(0, 1fr); margin-top: 72px; }
    .snt-about-side { grid-column: 1 / -1; margin-bottom: 40px; }
    .snt-about-side dl { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .snt-about-text { grid-column: 1 / -1; }
    .snt-foot-top { grid-template-columns: 1fr 1fr; }
  }

  /* Phone */
  @media (max-width: 760px) {
    .snt-nav ul li:not(:last-child) { display: none; }
    :global(.js) .snt-hero { height: 200svh; }
    .snt-stage {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto auto;
      align-content: start;
      row-gap: 0;
      padding-top: 84px;
      padding-bottom: 0;
      min-height: 0;
    }
    .snt-sentence { grid-row: 1 / span 3; grid-template-rows: subgrid; }
    .snt-half { font-size: clamp(44px, 13.5vw, 72px); }
    .snt-half-a { grid-column: 1; grid-row: 1; }
    .snt-half-b { grid-column: 1; grid-row: 3; }
    .snt-reel {
      grid-column: 1;
      grid-row: 2;
      align-self: auto;
      margin: 14px calc(-1 * var(--m));
      padding: 0 var(--m);
    }
    .snt-reel-window { position: relative; inset: auto; aspect-ratio: 4 / 3; overflow: hidden; margin-block: 28px; }
    .snt-reel-track { top: 0; margin-top: 0; }
    .snt-frame { aspect-ratio: 4 / 3; opacity: 1; }
    .snt-reel-caption { display: none; }
    .snt-hero-foot { position: static; grid-column: 1; grid-row: 4; grid-template-columns: 1fr; gap: 14px; margin-top: 20px; }
    .snt-support, .snt-hero-actions { grid-column: 1; justify-content: flex-start; padding: 0; }
    .snt-support { font-size: 16px; }

    .snt-method-head { display: block; }
    .snt-method-head p { margin-top: 16px; }
    .snt-panel-pic { aspect-ratio: 4 / 5; }
    .snt-tone-3 .snt-panel-pic { padding: 20px; }
    .snt-note dl > div { grid-template-columns: 1fr; gap: 2px; }
    .snt-panel-text { padding: 32px var(--m) 72px; }

    .snt-facts { gap: 40px 16px; margin-top: 64px; }
    .snt-row { font-size: 11vw; }
    .snt-spread-who { flex-direction: column; gap: 4px; font-size: 15px; }
    .snt-spread-who span:nth-child(2) { text-align: center; }
    .snt-spread-who span:nth-child(3) { text-align: right; }
    .snt-quote-more { grid-template-columns: 1fr; margin-top: 80px; }
    .snt-about-side dl { grid-template-columns: 1fr; gap: 10px; }
    .snt-bio { font-size: var(--step-body); line-height: 1.5; }
    .snt-names { font-size: 20px; line-height: 1.3; }
    .snt-dropcap { width: 5.2em; height: 5.2em; }

    .snt :global(.bb-who) { grid-template-columns: 1fr; }
    .snt :global(.bb-sentence) { font-size: 24px; line-height: 1.6; }
    .snt-brief-side { grid-template-columns: 96px minmax(0, 1fr); gap: 16px; }
    .snt-brief-side img { width: 96px; height: 96px; }

    .snt-foot-top { grid-template-columns: 1fr; gap: 10px; }
    .snt-mail a { flex-direction: column; font-size: 10vw; }
    .snt-foot-meta { flex-direction: column; gap: 6px; }
  }

  /* Motion: load sequence, entrances, drift. Everything is visible without script or with reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .snt-half [data-line] { transform: translateY(105%); animation: snt-line 900ms var(--ease-expo) forwards; animation-delay: calc(120ms + var(--i) * 110ms); }
    :global(.js) .snt [data-load] { opacity: 0; transform: translateY(14px); animation: snt-rise 520ms var(--ease-out) forwards; animation-delay: var(--d); }
    :global(.js) .snt-reel { clip-path: inset(0 0 100% 0); animation: snt-open 1000ms var(--ease-in-out) 120ms forwards; }
    :global(.js) .snt [data-reveal] { opacity: 0; transform: translateY(24px); transition: opacity 700ms var(--ease-out), transform 900ms var(--ease-expo); transition-delay: var(--d, 0ms); }
    :global(.js) .snt [data-reveal].is-in { opacity: 1; transform: none; }
    .snt [data-drift] { transform: scale(1.08); transition: transform 1600ms cubic-bezier(0.33, 1, 0.68, 1); }
    .snt [data-drift].is-in { transform: scale(1); }
  }
  @keyframes snt-line { to { transform: none; } }
  @keyframes snt-rise { to { opacity: 1; transform: none; } }
  @keyframes snt-open { to { clip-path: inset(0 0 0 0); } }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .snt-hero { height: 100svh; }
  }
</style>

<script>
  const root = document.querySelector('.snt');
  if (root) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Entrances, once, as each part arrives.
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.12 }
    );
    root.querySelectorAll('[data-reveal], [data-drift]').forEach((el) => io.observe(el));

    // The pinned story: the reel advances one frame per step while the sentence holds.
    const hero = root.querySelector('[data-story]') as HTMLElement | null;
    const track = root.querySelector('[data-reel]') as HTMLElement | null;
    const caption = root.querySelector('[data-reel-caption]') as HTMLElement | null;
    const captions = [
      'Brief: what the first year must deliver',
      'Map: the whole market on one page',
      'Shortlist: a written note on every candidate',
      'Close: Alex stays on until they start',
    ];
    if (hero && track && !reduce) {
      const frames = Array.from(track.children) as HTMLElement[];
      let ticking = false;
      let current = -1;
      const update = () => {
        ticking = false;
        const rect = hero.getBoundingClientRect();
        const travel = hero.offsetHeight - window.innerHeight;
        const p = travel > 0 ? Math.min(1, Math.max(0, -rect.top / travel)) : 0;
        const fh = frames[0].offsetHeight;
        const step = fh + 24;
        track.style.setProperty('--fh', `${fh}px`);
        // Frame i sits in the middle of the strip; between steps the strip glides.
        const pos = p * (frames.length - 1);
        track.style.setProperty('--reel-y', `${-pos * step}px`);
        const idx = Math.round(pos);
        if (idx !== current) {
          current = idx;
          frames.forEach((f, k) => f.classList.toggle('is-on', k === idx));
          if (caption) caption.textContent = captions[idx];
        }
      };
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };
      update();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
    } else if (track) {
      const f = track.firstElementChild as HTMLElement;
      track.style.setProperty('--fh', `${f.offsetHeight}px`);
      Array.from(track.children).forEach((c) => c.classList.add('is-on'));
    }

    // Track record: one placement lit at a time.
    const names = Array.from(root.querySelectorAll('.snt-name'));
    if (names.length && !reduce) {
      let i = 0;
      names[0].classList.add('is-lit');
      setInterval(() => {
        names[i].classList.remove('is-lit');
        i = (i + 1) % names.length;
        names[i].classList.add('is-lit');
      }, 2000);
    } else {
      names.forEach((n) => n.classList.add('is-lit'));
    }
  }
</script>
