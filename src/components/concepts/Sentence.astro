  /* About */
  .snt-about {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0 24px;
    padding: var(--gap) var(--m) calc(var(--gap) * 0.8);
  }
  .snt-about-side { grid-column: 1 / span 3; }
  .snt-about-side dl { display: grid; gap: 18px; }
  .snt-about-side dt { font-weight: 600; font-size: 15px; }
  .snt-about-side dd { font-size: 15px; }
  .snt-about-text { grid-column: 4 / span 9; }
  .snt-bio { font-size: var(--step-statement); line-height: 1.25; }
  .snt-bio strong { font-weight: 600; }
  .snt-bio-2 { margin-top: 1.6em; font-size: var(--step-body); line-height: 1.55; color: var(--muted); max-width: 40rem; clear: both; }
