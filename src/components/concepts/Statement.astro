<script>
  const root = document.querySelector('.stm');
  if (root) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.12 }
    );
    root.querySelectorAll('[data-reveal], [data-diagram]').forEach((el) => io.observe(el));

    // The lit name moves through the placed roles every two seconds.
    const names = Array.from(root.querySelectorAll('[data-names] .stm-name'));
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (names.length && !still) {
      let i = 0;
      setInterval(() => {
        names[i].classList.remove('is-lit');
        i = (i + 1) % names.length;
        names[i].classList.add('is-lit');
      }, 2000);
    }
  }
</script>
