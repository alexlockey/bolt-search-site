  /* Contact */
  .pf-contact { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 24px; padding: 160px var(--m); background: var(--panel); }
  .pf-contact-main { grid-column: 1 / 8; }
  .pf-contact-side { grid-column: 9 / 13; display: flex; flex-direction: column; gap: 40px; }
  .pf-prompt { font-size: var(--s-head); max-width: 20ch; margin-bottom: 40px; }
    .pf-next { margin-top: 20px; font-size: var(--s-small); color: var(--ink); max-width: 52ch; }

  .pf .bb-sentence { font-size: var(--s-lead); line-height: 1.9; font-weight: 500; letter-spacing: -0.01em; color: var(--ink); }
  .pf .bb-slot input {
    background: var(--ink); color: var(--bg); border: 0; border-radius: var(--r); padding: 4px 10px; margin: 0 4px;
    font-weight: 500; min-width: 8ch; transition: outline-color 120ms ease;
  }
  .pf .bb-slot input::placeholder { color: #6E727A; }
  .pf .bb-slot input:focus { outline: none; outline: 2px solid var(--accent); outline-offset: -2px; }
  .pf .bb-slot input[aria-invalid] { outline: 2px solid #F2994A; outline-offset: -2px; }
  .pf .bb-who { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 32px; }
  .pf .bb-field { display: flex; flex-direction: column; gap: 6px; font-size: var(--s-small); color: var(--muted); }
  .pf .bb-field input {
    font: inherit; font-size: var(--s-body); color: var(--ink); background: var(--raised-2); border: 0; border-radius: var(--r);
    padding: 0 14px; min-height: 48px; transition: background-color 120ms ease;
  }
  .pf .bb-field input:hover { background: var(--raised-2); }
  .pf .bb-field input:focus { outline: none; outline: 2px solid var(--accent); outline-offset: -2px; }
  .pf .bb-field input[aria-invalid] { outline: 2px solid #F2994A; outline-offset: -2px; }
  .pf .bb-actions { display: flex; align-items: center; gap: 20px; margin-top: 24px; flex-wrap: wrap; }
  .pf .bb-send {
    font: inherit; font-size: var(--s-small); font-weight: 560; min-height: 48px; padding: 0 22px; border: 0; border-radius: var(--r);
    background: var(--accent); color: var(--accent-ink); cursor: pointer; transition: background-color 160ms ease, transform 120ms ease;
  }
  .pf .bb-send:hover { background: #2DB4F0; }
  .pf .bb-send:active { transform: scale(0.97); }
  .pf .bb-send:disabled { opacity: 0.6; cursor: progress; }
  .pf .bb-status { font-size: var(--s-small); color: #F2994A; }
  .pf .bb-done { font-size: var(--s-body); color: var(--muted); }
  .pf .bb-done-title { font-size: var(--s-lead); color: var(--ink); margin-bottom: 8px; }

  .pf .pf-briefcard[data-ui] { background: #0B0C0D; border: 1px solid #2A2C31; border-radius: 8px; padding: 16px; }
  .pf .pf-briefcard[data-ui] .ui-card-title { font-size: var(--s-small); margin-bottom: 10px; }
