  /* About: founder's note */
  .pf-about { padding: 160px var(--m); }
  .pf-about-col { max-width: 560px; margin: 0 auto; }
  .pf-about img { width: 88px; height: 88px; border-radius: 50%; object-fit: cover; filter: grayscale(1) contrast(1.05); margin-bottom: 24px; }
  .pf-about h2 { font-size: var(--s-head); margin-bottom: 24px; }
