  .pf-reach { display: grid; gap: 14px; font-size: var(--s-small); }
  .pf-reach div { display: grid; grid-template-columns: 90px 1fr; gap: 12px; }
  .pf-reach dt { color: var(--muted); }
  .pf-reach a { text-underline-offset: 4px; }

  /* Footer board */
  .pf-foot { display: grid; grid-template-columns: repeat(12, 1fr); gap: 8px; padding: 8px; background: var(--bg); }
  .pf-ft { background: var(--panel); border-radius: var(--r); padding: 24px; min-height: 220px; text-decoration: none; }
  .pf-ft-statement { grid-column: 1 / 5; display: flex; flex-direction: column; justify-content: space-between; }
  .pf-ft-statement p:first-child { font-size: var(--s-lead); line-height: 1.3; max-width: 22ch; }
  .pf-legal { font-size: 13px; color: var(--soft); }
  .pf-ft-nav { grid-column: 5 / 8; display: flex; flex-direction: column; gap: 8px; font-size: var(--s-small); }
  .pf-ft-nav a { color: var(--muted); text-decoration: none; transition: color 160ms ease; }
  .pf-ft-nav a:hover { color: var(--ink); }
  .pf-ft-time { grid-column: 8 / 10; display: flex; flex-direction: column; justify-content: space-between; font-size: var(--s-small); color: var(--muted); }
  .pf-clock { font-size: var(--s-lead); color: var(--ink); font-variant-numeric: tabular-nums; }
  .pf-ft-mail { grid-column: 10 / 13; display: flex; align-items: flex-end; font-size: var(--s-lead); }
  .pf-ft-mail a { text-underline-offset: 5px; }
  .pf-ft-word { grid-column: 1 / 9; min-height: 320px; background: var(--ink); color: var(--bg); display: grid; place-items: center; overflow: hidden; }
  .pf-ft-word span { font-size: 9vw; font-weight: 600; letter-spacing: -0.04em; line-height: 1; white-space: nowrap; }
  .pf .pf-ft-cta { grid-column: 9 / 13; min-height: 320px; background: var(--accent); color: var(--accent-ink); display: flex; flex-direction: column; justify-content: space-between; transition: background-color 160ms ease; }
  .pf .pf-ft-cta:hover { background: #2DB4F0; }
  .pf-ft-cta span { font-size: var(--s-head); font-weight: 560; letter-spacing: -0.015em; }
  .pf-ft-cta svg { width: 56px; height: 56px; align-self: flex-end; fill: none; stroke: currentColor; stroke-width: 4; transition: transform 200ms var(--ease); }
  .pf-ft-cta:hover svg { transform: translate(4px, -4px); }

  /* Motion: the shutter on the stage, rises on load and on scroll. Content stays visible without script. */
  @media (prefers-reduced-motion: no-preference) {
    .pf-stage { animation: pf-shutter 1100ms cubic-bezier(.65, 0, .35, 1) 150ms both; }
    .pf-app { animation: pf-settle 1500ms var(--ease) 100ms both; }
    .pf [data-load] { animation: pf-rise 600ms var(--ease) var(--d) both; }
    .pf.pf-js [data-rise] { opacity: 0.18; transform: translateY(28px); transition: opacity 600ms var(--ease) var(--d), transform 900ms var(--ease) var(--d); }
    .pf.pf-js [data-rise].is-in { opacity: 1; transform: none; }
    .pf.pf-js .pf-card[data-rise].is-in:hover { transform: translateY(-6px); transition-delay: 0ms; }
  }
  @keyframes pf-shutter { from { clip-path: polygon(0 100%, 180px 100%, 204px 100%, 100% 100%, 100% 100%, 0 100%); } to { clip-path: polygon(0 28px, 180px 28px, 204px 0, 100% 0, 100% 100%, 0 100%); } }
  @keyframes pf-settle { from { transform: translateY(40px) scale(1.04); opacity: 0.4; } to { transform: none; opacity: 1; } }
  @keyframes pf-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  /* Tablet */
  @media (max-width: 1100px) {
    .pf-strip { grid-template-columns: repeat(2, 1fr); }
    .pf-field { min-height: 72svh; min-height: max(560px, 72svh); }
    .pf-tiles { grid-template-columns: repeat(2, 1fr); }
    .pf-letter-body { grid-column: 4 / 13; }
    .pf-contact-main { grid-column: 1 / 13; }
    .pf-contact-side { grid-column: 1 / 13; margin-top: 56px; flex-direction: row; flex-wrap: wrap; }
    .pf-contact-side > * { flex: 1 1 300px; }
    .pf-ft-statement { grid-column: 1 / 7; }
    .pf-ft-nav { grid-column: 7 / 13; }
    .pf-ft-time { grid-column: 1 / 7; }
    .pf-ft-mail { grid-column: 7 / 13; }
    .pf-ft-word { grid-column: 1 / 13; min-height: 220px; }
    .pf-ft-word span { font-size: 13vw; }
    .pf .pf-ft-cta { grid-column: 1 / 13; min-height: 200px; }
  }
  @media (max-width: 900px) {
    .pf-hero-text { max-width: none; padding-top: 48px; }
    .pf-hero { min-height: 0; padding-bottom: 0; }
    .pf-stage { position: relative; left: auto; top: auto; margin-top: 48px; height: 560px; clip-path: polygon(0 24px, 120px 24px, 144px 0, 100% 0, 100% 100%, 0 100%); }
    .pf-app { left: var(--m); top: 64px; }
