  .pf-clause { font-size: var(--s-lead); line-height: 1.25; font-weight: 520; letter-spacing: -0.012em; max-width: 15ch; margin-top: 32px; }
  .pf-field-1 .pf-clause, .pf-field-2 .pf-clause, .pf-field-3 .pf-clause { color: var(--ink); }

  /* Proof tiles */
  .pf-proof { padding: 160px var(--m) 120px; }
  .pf-tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .pf-tile { background: var(--panel); border-radius: var(--r); padding: 24px; min-height: 200px; display: flex; flex-direction: column; justify-content: flex-start; }
