  .pf-tile-head p { font-size: var(--s-small); max-width: 34ch; color: var(--accent-ink); }
  .pf-tile-big { font-size: var(--s-lead); font-weight: 600; letter-spacing: -0.015em; line-height: 1.2; margin-bottom: 10px; }
  .pf-tile-fact .pf-tile-big { font-size: var(--s-head); font-weight: 560; }
  .pf-tile-small { font-size: var(--s-small); color: var(--muted); }
  .pf-roles { margin-top: 56px; font-size: var(--s-lead); line-height: 1.45; color: var(--ink); max-width: 56ch; }
