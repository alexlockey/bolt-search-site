  /* Phone */
  @media (max-width: 640px) {
    .pf { --m: 20px; }
    .pf-nav nav a:not(.pf-btn) { display: none; }
    .pf-hero h1 { font-size: 10.6vw; }
    .pf-support { font-size: var(--s-body); }
    .pf-stage { height: 480px; }
    .pf-app { right: auto; width: 520px; height: 440px; }
    .pf [data-ui] .ui-split { grid-template-columns: 1fr; }
    .pf [data-ui] .ui-panel { display: none; }
    .pf [data-ui] .ui-row { grid-template-columns: 14px 90px 1fr 48px; }
    .pf-strip { grid-template-columns: 1fr; }
    .pf-field { min-height: 64svh; min-height: max(520px, 64svh); padding: 32px 20px; }
    .pf-proof { padding: 96px var(--m) 80px; }
    .pf-tiles { grid-template-columns: 1fr 1fr; gap: 6px; }
    .pf-tile { min-height: 150px; padding: 16px; }
    .pf-tile-head { grid-column: span 2; min-height: 120px; }
    .pf-tile-big { font-size: var(--s-body); }
    .pf-roles { font-size: var(--s-body); margin-top: 40px; }
    .pf-letter { padding: 96px var(--m); }
    .pf-letter h2, .pf-letter-body { grid-column: 1 / 13; }
    .pf-letter h2 { margin-bottom: 32px; }
    .pf-about { padding: 96px var(--m); }
    .pf-contact { padding: 96px var(--m); }
    .pf .bb-who { grid-template-columns: 1fr; }
    .pf .bb-sentence { font-size: var(--s-lead); }
    .pf-foot { gap: 6px; padding: 6px; }
    .pf-ft { min-height: 140px; padding: 20px; }
    .pf-ft-statement, .pf-ft-nav, .pf-ft-time, .pf-ft-mail { grid-column: 1 / 13; }
    .pf-ft-word { min-height: 160px; }
    .pf .pf-ft-cta { min-height: 160px; }
  }
</style>

<script>
  const root = document.getElementById('pf-root');
  if (root) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Section entrances: hidden state only applies once this script has run.
    if (!reduce && 'IntersectionObserver' in window) {
      root.classList.add('pf-js');
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
        { rootMargin: '0px 0px 6% 0px' },
      );
      root.querySelectorAll('[data-rise]').forEach((el) => io.observe(el));
      // Anything already on screen at load
      requestAnimationFrame(() => root.querySelectorAll('[data-rise]').forEach((el) => {
        const r = el.getBoundingClientRect();
        if (r.top < innerHeight && r.bottom > 0) el.classList.add('is-in');
      }));
    }

    // The hero fragment works: choose a candidate to open their note.
    const rows = Array.from(root.querySelectorAll<HTMLButtonElement>('.ui-row'));
    const notes = Array.from(root.querySelectorAll<HTMLElement>('[data-note]'));
    const ids = notes.map((n) => n.dataset.note as string);
    let cycle: number | undefined;
    const show = (id: string) => {
      if (!ids.includes(id)) return;
      notes.forEach((n) => (n.hidden = n.dataset.note !== id));
      rows.forEach((r) => {
        const on = r.dataset.id === id;
        r.classList.toggle('is-sel', on);
        r.setAttribute('aria-selected', String(on));
      });
    };
    rows.forEach((r) =>
      r.addEventListener('click', () => {
        if (cycle) { clearInterval(cycle); cycle = undefined; }
        show(r.dataset.id as string);
      }),
    );
    // The one moving picture: the note cycles through the shortlist until someone takes over.
    if (!reduce) {
      let i = 0;
      cycle = window.setInterval(() => { i = (i + 1) % ids.length; show(ids[i]); }, 4200);
      root.querySelector('.pf-app')?.addEventListener('pointerenter', () => { if (cycle) { clearInterval(cycle); cycle = undefined; } });
    }

    // The brief card fills in as the visitor writes the sentence.
    const form = root.querySelector<HTMLFormElement>('#brief-form');
    const mirrors = root.querySelectorAll<HTMLElement>('[data-mirror]');
    const defaults = new Map<HTMLElement, string>();
    mirrors.forEach((m) => { defaults.set(m, m.textContent || ''); m.classList.add('is-empty'); });
    form?.addEventListener('input', () => {
      mirrors.forEach((m) => {
        const field = form.elements.namedItem(m.dataset.mirror as string) as HTMLInputElement | null;
        const v = field?.value.trim() || '';
        m.textContent = v || defaults.get(m) || '';
        m.classList.toggle('is-empty', !v);
      });
    });

    // UK time in the footer.
    const clock = root.querySelector('#pf-clock');
    const tick = () => {
      if (clock) clock.textContent = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', hour: '2-digit', minute: '2-digit' }).format(new Date());
    };
    tick();
    setInterval(tick, 30000);
  }
</script>
