  /* References as a letter */
  .pf-letter { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 24px; padding: 140px var(--m); background: var(--panel); }
  .pf-letter h2 { grid-column: 1 / 4; font-size: var(--s-head); }
