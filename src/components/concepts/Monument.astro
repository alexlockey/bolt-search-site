---
// Concept A, the name as a monument.
// Idea: Alex, the one person who runs every search, becomes the glyph in the word space of the name: Bolt [photo] Search.
// Direction sheet: .taste-skill/sheet-name-as-monument.md (graphite and orange, Boska, shutter image).
import BriefBuilder from '../BriefBuilder.astro';
import { hero, navLinks, method, shortlistNote, facts, placements, roles, quotes, about, brief, contact } from '../../data/site';

const lead = quotes[1];
const corners = [quotes[0], quotes[3], quotes[4]];
const reel = placements.map((p) => p.role);
---

<link rel="preconnect" href="https://api.fontshare.com" />
<link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
<link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=boska@400,401,500&display=swap" />

<div class="mon" id="top">
  <header class="mon-hero">
    <nav class="mon-nav" aria-label="Main">
      <a href="#top" class="mon-mark">Bolt Search</a>
      <ul>
        {navLinks.map((l) => <li><a href={l.href} class="mon-link">{l.label}</a></li>)}
        <li><a href={hero.action.href} class="mon-btn mon-btn-small">Contact</a></li>
      </ul>
    </nav>

    <h1 class="mon-name">
      <span>Bolt</span>
      <span class="mon-glyph" data-shutter>
        <img src="/images/alex-headshot-600.webp" alt="" width="600" height="804" fetchpriority="high" />
      </span>
      <span>Search</span>
    </h1>

    <div class="mon-hero-foot">
      <p class="mon-support" data-reveal>{hero.support}</p>
      <div class="mon-hero-actions" data-reveal style="--d:120ms">
        <a href={hero.action.href} class="mon-btn">{hero.action.label}</a>
        <a href={hero.second.href} class="mon-link">{hero.second.label}</a>
      </div>
    </div>
  </header>

  <section class="mon-method" id="method" aria-label={method.heading}>
    {method.stages.map((s, i) => (
      <article class={`mon-stage ${s.image ? '' : 'mon-stage-light'}`}>
        <div class="mon-verb-wrap">
          <h2 class="mon-verb">{s.verb}</h2>
        </div>
        {s.image ? (
          <figure class="mon-stage-pic">
            <img src={`${s.image}.webp`} alt={s.alt} width="896" height="1200" loading="eager" />
          </figure>
        ) : (
          <figure class="mon-note" data-reveal>
            <figcaption>{shortlistNote.label}. Illustrative, no real candidate.</figcaption>
            <p class="mon-note-name">{shortlistNote.candidate}</p>
            <dl>
              {shortlistNote.rows.map(([k, v]) => (
                <div><dt>{k}</dt><dd>{v}</dd></div>
              ))}
            </dl>
          </figure>
        )}
        <div class="mon-stage-text" data-reveal>
          <p class="mon-stage-line">{s.line}</p>
          <p>{s.body}</p>
          {s.verb === 'Map' && <p class="mon-stage-note">{method.note}</p>}
        </div>
      </article>
    ))}
  </section>

  <section class="mon-record" id="record" aria-labelledby="record-h">
    <div class="mon-marquee" aria-hidden="true">
      <div class="mon-marquee-track">
        {[0, 1].map(() => (
          <span class="mon-marquee-run">
            {reel.map((r) => <span class="mon-marquee-item">{r}<i></i></span>)}
          </span>
        ))}
      </div>
    </div>
    <p class="mon-marquee-caption">Recent placements, by role. Clients and candidates are never named without their permission.</p>

    <div class="mon-record-body">
      <div class="mon-record-intro">
        <h2 id="record-h" class="mon-h2" data-reveal>Track record</h2>
        <dl class="mon-facts">
          {facts.map((f, i) => (
            <div data-reveal style={`--d:${i * 80}ms`}>
              <dt>{f.figure}</dt>
              <dd>{f.label}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="mon-record-lists">
        <table class="mon-table">
          <caption>Placements on record</caption>
          <thead><tr><th scope="col">Role</th><th scope="col">Company</th><th scope="col">Year</th></tr></thead>
          <tbody>
            {placements.map((p, i) => (
              <tr data-reveal style={`--d:${i * 60}ms`}><td>{p.role}</td><td>{p.company}</td><td>{p.year}</td></tr>
            ))}
          </tbody>
        </table>
        <div class="mon-roles">
          <h3>The roles we fill, in any market</h3>
          <ul>
            {roles.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="mon-voices" aria-labelledby="voices-h">
    <h2 id="voices-h" class="mon-voices-h" data-reveal>What clients and candidates say</h2>
    <figure class="mon-lead" data-reveal style="--d:100ms">
      <blockquote><p>{lead.text}</p></blockquote>
      <figcaption>{lead.who}</figcaption>
    </figure>
    <div class="mon-corners">
      {corners.map((q, i) => (
        <figure data-reveal style={`--d:${200 + i * 100}ms`}>
          <blockquote><p>{q.text}</p></blockquote>
          <figcaption>{q.who}</figcaption>
        </figure>
      ))}
      <p class="mon-voices-note" data-reveal style="--d:400ms">
        Paraphrased from fifteen LinkedIn recommendations. <a href={hero.second.href} class="mon-link">Ask to speak to a reference</a>
      </p>
    </div>
  </section>

  <section class="mon-about" id="alex" aria-labelledby="alex-h">
    <h2 id="alex-h" class="mon-about-h" data-reveal>{about.heading}</h2>
    <div class="mon-about-grid">
      <div class="mon-about-text">
        {about.body.map((t, i) => <p data-reveal style={`--d:${i * 100}ms`}>{t}</p>)}
      </div>
      <dl class="mon-about-facts" data-reveal style="--d:200ms">
        {about.facts.map(([k, v]) => (
          <div><dt>{k}</dt><dd>{v}</dd></div>
        ))}
        <div><dt>Profile</dt><dd><a href={about.linkedin} class="mon-link" target="_blank" rel="noopener">Alex on LinkedIn</a></dd></div>
      </dl>
    </div>
  </section>

  <section class="mon-contact" id="brief" aria-labelledby="brief-h">
    <div class="mon-contact-top">
      <h2 id="brief-h" class="mon-h2" data-reveal>{brief.heading}</h2>
      <p class="mon-contact-lead" data-reveal style="--d:80ms">{brief.lead}</p>
    </div>
    <div class="mon-brief" data-reveal style="--d:160ms">
      <BriefBuilder />
    </div>
    <p class="mon-contact-after">{brief.after} {contact.reply}</p>
    <a href={`mailto:${contact.email}`} class="mon-email">
      <span>alex@</span><span>bolt-search.com</span>
    </a>
  </section>

  <footer class="mon-footer">
    <p class="mon-footer-name" aria-hidden="true">Bolt Search</p>
    <div class="mon-footer-row">
      <ul class="mon-places">
        <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li><a href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href="/contact/">Contact form</a></li>
      </ul>
      <ul class="mon-footer-links">
        {navLinks.map((l) => <li><a href={l.href} class="mon-link">{l.label}</a></li>)}
        <li><a href={hero.second.href} class="mon-link">Ask for references</a></li>
      </ul>
      <p class="mon-footer-note">{contact.where} Photographs are of Alex Lockey and are his own.</p>
    </div>
    <div class="mon-footer-legal">
      <span>© 2026 Bolt Search</span>
      <a href="#top" class="mon-link">Back to top</a>
    </div>
  </footer>
</div>

<style is:global>
  body:has(.mon) {
    margin: 0;
    background: #18191b;
  }

  .mon {
    --bg: #18191b;
    --surface: #222427;
    --ink: #eff0f1;
    --muted: #a3a5aa;
    --accent: #ff4a1f;
    --accent-strong: #ff6a45;
    --accent-ink: #18191b;
    --field: #eff0f1;
    --field-ink: #18191b;
    --field-muted: #55585e;
    --field-tone: #e1e2e4;

    --serif: 'Boska', Georgia, 'Times New Roman', serif;
    --step-small: clamp(0.875rem, 0.85rem + 0.1vw, 0.9375rem);
    --step-body: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    --step-lead: clamp(1.375rem, 1.1rem + 0.9vw, 2rem);
    --step-head: clamp(2rem, 1.3rem + 3.2vw, 4rem);
    --step-display: clamp(3.5rem, 11.2vw, 12rem);

    --m: clamp(20px, 2.4vw, 32px);
    --gap: clamp(64px, 7vw, 112px);

    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-in-out: cubic-bezier(0.76, 0, 0.24, 1);
    --ease-soft: cubic-bezier(0.33, 1, 0.68, 1);

    background: var(--bg);
    color: var(--ink);
    font-family: var(--serif);
    font-size: var(--step-body);
    line-height: 1.5;
    letter-spacing: 0.005em;
    -webkit-font-smoothing: antialiased;
    border-top: 10px solid var(--accent);
    overflow-x: clip;
  }

  .mon *, .mon *::before, .mon *::after { box-sizing: border-box; }
  :where(.mon) :where(h1, h2, h3, p, ul, dl, dd, figure, blockquote, table) { margin: 0; padding: 0; }
  :where(.mon) :where(ul) { list-style: none; }
  .mon img { display: block; max-width: 100%; }
  .mon a { color: inherit; }
  .mon :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }

  /* Controls */
  .mon .mon-link {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-underline-offset: 0.2em;
    text-decoration-thickness: 0.07em;
    transition: text-decoration-color 180ms ease, color 180ms ease;
  }

  .mon .mon-btn,
  .mon .bb-send {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 1.5rem;
    background: var(--accent);
    color: var(--accent-ink);
    font: 500 var(--step-body) / 1 var(--serif);
    text-decoration: none;
    border: 0;
    border-radius: 0;
    cursor: pointer;
    transition: transform 140ms var(--ease-out), background-color 180ms ease;
  }

  .mon .mon-btn:active,
  .mon .bb-send:active { transform: scale(0.97); }

  .mon .mon-btn-small { min-height: 40px; padding: 0 1rem; font-size: var(--step-small); }

  @media (hover: hover) and (pointer: fine) {
    .mon .mon-link:hover { text-decoration-color: currentColor; }
    .mon .mon-btn:hover,
    .mon .bb-send:hover { background: var(--accent-strong); }
  }

  /* Hero: the name with Alex in its word space */
  .mon-hero {
    min-height: calc(100svh - 46px);
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 0 var(--m) var(--m);
  }

  .mon-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    font-size: var(--step-small);
  }

  .mon-mark {
    font-weight: 500;
    font-size: var(--step-body);
    text-decoration: none;
  }

  .mon-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
  }

  .mon-name {
    align-self: center;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.12em;
    font-weight: 400;
    font-size: var(--step-display);
    line-height: 0.95;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }

  .mon-glyph {
    display: inline-block;
    width: 1.18em;
    height: 0.7em;
    overflow: hidden;
    align-self: baseline;
    position: relative;
    top: 0.02em;
  }

  .mon-glyph img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 26%;
    filter: grayscale(1) contrast(1.05);
  }

  .mon-hero-foot {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0 24px;
    align-items: end;
  }

  .mon-support {
    grid-column: 1 / span 7;
    font-size: var(--step-lead);
    line-height: 1.35;
    max-width: 38ch;
  }

  .mon-hero-actions {
    grid-column: 1 / span 7;
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 28px;
  }

  /* Method: one verb at a time */
  .mon-method {
    margin-top: var(--gap);
  }

  .mon-stage {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0 24px;
    padding: 0 var(--m);
    background: var(--bg);
  }

  .mon-stage:nth-child(even) { background: var(--surface); }

  .mon-verb-wrap {
    grid-column: 1 / -1;
    grid-row: 1;
    position: relative;
    z-index: 2;
    pointer-events: none;
  }

  .mon-verb {
    position: sticky;
    top: 50%;
    transform: translateY(-50%);
    margin: 50svh 0;
    font-weight: 400;
    font-size: var(--step-display);
    line-height: 0.9;
    letter-spacing: -0.045em;
    color: var(--ink);
  }

  .mon-stage-pic {
    grid-column: 6 / -1;
    grid-row: 1;
    align-self: stretch;
    overflow: hidden;
  }

  .mon-stage-pic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) brightness(0.62) contrast(1.05);
  }

  .mon-stage-text {
    grid-column: 1 / span 4;
    grid-row: 1;
    align-self: end;
    position: relative;
    z-index: 3;
    padding-bottom: var(--m);
    max-width: 34ch;
  }

  .mon-stage-line {
    font-size: var(--step-lead);
    line-height: 1.25;
    margin-bottom: 12px;
  }

  .mon-stage-text p + p { color: var(--ink); }

  .mon-stage-note { margin-top: 12px; }

  .mon-stage-light {
    background: var(--field) !important;
    color: var(--field-ink);
  }

  .mon-stage-light .mon-verb { color: var(--field-ink); }
  .mon-stage-light .mon-stage-text p + p { color: var(--field-ink); }

  .mon-note {
    grid-column: 7 / -1;
    grid-row: 1;
    align-self: center;
    position: relative;
    z-index: 3;
    background: var(--field-tone);
    padding: clamp(24px, 3vw, 40px);
    color: var(--field-ink);
  }

  .mon-note figcaption {
    color: var(--field-muted);
    font-size: var(--step-small);
    margin-bottom: 10px;
  }

  .mon-note-name {
    font-size: var(--step-lead);
    margin-bottom: 18px;
  }

  .mon-note dl { display: grid; gap: 2px; }

  .mon-note dl div {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 16px;
    padding: 12px 14px;
    background: var(--field);
  }

  .mon-note dt { color: var(--field-muted); }

  /* Record: names running off the edges, then the ledger */
  .mon-record {
    background: var(--field);
    color: var(--field-ink);
    padding-bottom: var(--gap);
  }

  .mon-marquee {
    background: var(--surface);
    color: var(--ink);
    height: clamp(160px, 34vh, 300px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .mon-marquee-track {
    display: flex;
    width: max-content;
  }

  .mon-marquee-run {
    display: flex;
    white-space: nowrap;
    font-size: var(--step-head);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .mon-marquee-item {
    display: inline-flex;
    align-items: center;
  }

  .mon-marquee-item i {
    display: inline-block;
    width: 0.2em;
    height: 0.2em;
    border-radius: 50%;
    background: var(--accent);
    margin: 0 0.45em;
  }

  .mon-marquee-caption {
    padding: 20px var(--m) 0;
    color: var(--field-muted);
    max-width: 62ch;
  }

  .mon-record-body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 48px 24px;
    padding: var(--gap) var(--m) 0;
  }

  .mon-h2 {
    font-weight: 400;
    font-size: var(--step-head);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .mon-record-intro { grid-column: 1 / span 4; }

  .mon-facts {
    display: grid;
    gap: 28px;
    margin-top: 40px;
  }

  .mon-facts dt {
    font-size: var(--step-head);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .mon-facts dd {
    color: var(--field-muted);
    margin-top: 6px;
    max-width: 26ch;
  }

  .mon-record-lists {
    grid-column: 6 / -1;
    display: grid;
    gap: 64px;
    align-content: start;
  }

  .mon-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 3px;
    font-size: var(--step-body);
  }

  .mon-table caption {
    text-align: left;
    font-size: var(--step-lead);
    padding-bottom: 14px;
  }

  .mon-table th {
    text-align: left;
    font-weight: 400;
    color: var(--field-muted);
    font-size: var(--step-small);
    padding: 0 14px 6px;
  }

  .mon-table td {
    background: var(--field-tone);
    padding: 14px;
    vertical-align: top;
  }

  .mon-table td:first-child { font-weight: 500; }
  .mon-table td:nth-child(2) { color: var(--field-muted); }
  .mon-table td:last-child { font-variant-numeric: tabular-nums; }

  .mon-roles h3 {
    font-weight: 400;
    font-size: var(--step-lead);
    margin-bottom: 14px;
  }

  .mon-roles ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .mon-roles li {
    background: var(--field-ink);
    color: var(--field);
    padding: 10px 16px;
  }

  /* Voices: one lead quotation, two in the corners */
  .mon-voices {
    display: grid;
    gap: 96px;
    padding: var(--gap) var(--m) var(--m);
    background: #111214;
  }

  .mon-voices-h {
    font-weight: 400;
    font-size: var(--step-lead);
    color: var(--muted);
  }

  .mon-lead {
    align-self: center;
    justify-self: center;
    width: min(100%, 24em);
    text-align: center;
  }

  .mon-lead p {
    font-size: var(--step-lead);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .mon-lead figcaption,
  .mon-corners figcaption {
    margin-top: 16px;
    color: var(--muted);
    font-size: var(--step-small);
  }

  .mon-corners {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 56px 24px;
    align-items: start;
  }

  .mon-corners figure { grid-column: span 4; max-width: 34ch; }
  .mon-corners figure:nth-of-type(2) { padding-top: 64px; }
  .mon-corners figure:nth-of-type(3) { padding-top: 128px; }

  .mon-voices-note {
    grid-column: 1 / -1;
    color: var(--muted);
  }

  /* About: the name again, the short biography, the facts */
  .mon-about {
    padding: var(--gap) var(--m);
  }

  .mon-about-h {
    font-weight: 400;
    font-size: var(--step-display);
    line-height: 0.9;
    letter-spacing: -0.045em;
    margin-bottom: 64px;
  }

  .mon-about-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 48px 24px;
    align-items: start;
  }

  .mon-about-text {
    grid-column: 1 / span 6;
    display: grid;
    gap: 20px;
    font-size: var(--step-lead);
    line-height: 1.35;
  }

  .mon-about-facts {
    grid-column: 8 / -1;
    display: grid;
    gap: 2px;
  }

  .mon-about-facts div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 16px;
    padding: 16px;
    background: var(--surface);
  }

  .mon-about-facts dt { color: var(--muted); }

  /* Contact: the brief sentence, then the email as display type */
  .mon-contact {
    background: var(--field);
    color: var(--field-ink);
    padding: var(--gap) var(--m) var(--m);
    display: grid;
    gap: 48px;
  }

  .mon-contact-top {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 16px 24px;
    align-items: end;
  }

  .mon-contact-top .mon-h2 { grid-column: 1 / span 6; }

  .mon-contact-lead {
    grid-column: 8 / -1;
    font-size: var(--step-lead);
    line-height: 1.35;
  }

  .mon-brief .bb-sentence {
    font-size: var(--step-lead);
    line-height: 1.6;
    letter-spacing: -0.01em;
    max-width: 44ch;
  }

  .mon-brief .bb-slot input {
    border: 0;
    border-radius: 0;
    background: var(--field-tone);
    padding: 0 0.3em;
    margin: 0 0.15em;
    color: var(--field-ink);
    min-width: 7ch;
  }

  .mon-brief .bb-slot input::placeholder { color: var(--field-muted); }

  .mon-brief .bb-slot input:focus { background: #d3d4d7; outline: 3px solid var(--accent); outline-offset: 0; }

  .mon-brief [aria-invalid="true"] { background: #ffd9cf !important; }

  .mon-brief .bb-who {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px 24px;
    margin-top: 40px;
    max-width: 960px;
  }

  .mon-brief .bb-field {
    display: grid;
    gap: 6px;
    font-size: var(--step-small);
    color: var(--field-muted);
  }

  .mon-brief .bb-field input {
    font: inherit;
    font-size: var(--step-body);
    color: var(--field-ink);
    background: var(--field-tone);
    border: 0;
    border-radius: 0;
    min-height: 48px;
    padding: 0 14px;
  }

  .mon-brief .bb-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 28px;
  }

  .mon-brief .bb-status { color: var(--field-ink); }

  .mon-brief .bb-done { max-width: 44ch; }
  .mon-brief .bb-done-title { font-size: var(--step-head); line-height: 1; margin-bottom: 16px; }

  .mon-contact-after { color: var(--field-muted); max-width: 62ch; }

  .mon-email {
    display: flex;
    flex-wrap: wrap;
    margin-top: 72px;
    font-size: var(--step-display);
    line-height: 0.95;
    letter-spacing: -0.045em;
    text-decoration: none;
    transition: color 180ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .mon-email:hover { color: var(--accent); }
  }

  .mon-contact-foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: var(--step-small);
    color: var(--field-muted);
  }

  /* Footer: the name first */
  .mon-footer {
    padding: var(--gap) var(--m) var(--m);
    padding-bottom: 28px;
    display: grid;
    gap: 72px;
  }

  .mon-footer-name {
    font-size: var(--step-display);
    line-height: 0.9;
    letter-spacing: -0.05em;
    white-space: nowrap;
  }

  .mon-footer-row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 32px 24px;
  }

  .mon-places {
    grid-column: 1 / span 5;
    display: grid;
    gap: 6px;
    font-size: var(--step-lead);
    line-height: 1.2;
  }

  .mon-places a { color: var(--accent); text-decoration: none; }

  @media (hover: hover) and (pointer: fine) {
    .mon-places a:hover { text-decoration: underline; text-underline-offset: 0.18em; text-decoration-thickness: 0.06em; }
  }

  .mon-footer-links {
    grid-column: 7 / span 3;
    display: grid;
    gap: 8px;
    font-size: var(--step-small);
  }

  .mon-footer-note {
    grid-column: 10 / -1;
    font-size: var(--step-small);
    color: var(--muted);
  }

  .mon-footer-legal {
    display: flex;
    justify-content: space-between;
    font-size: var(--step-small);
    color: var(--muted);
  }

  /* Phone and tablet compositions */
  @media (max-width: 900px) {
    .mon { --step-display: clamp(3.5rem, 18vw, 9rem); }
    .mon-email { font-size: var(--step-head); }
    .mon-nav li:not(:last-child) { display: none; }
    .mon-name {
      flex-direction: column;
      align-items: center;
      gap: 0.08em;
      line-height: 0.9;
    }
    .mon-glyph {
      width: min(100%, 520px);
      height: auto;
      aspect-ratio: 3 / 2;
      margin: 0.06em 0;
    }
    .mon-glyph img { object-position: 50% 30%; }
    .mon-hero-foot { grid-template-columns: 1fr; gap: 24px; }
    .mon-support, .mon-hero-actions { grid-column: 1 / -1; }

    .mon-stage { grid-template-columns: 1fr; min-height: 0; padding-top: 72px; padding-bottom: 24px; }
    .mon-verb-wrap, .mon-stage-pic, .mon-stage-text, .mon-note { grid-column: 1; grid-row: auto; }
    .mon-verb { position: static; transform: none; margin: 0 0 24px; }
    .mon-stage-pic img { aspect-ratio: 4 / 5; height: auto; }
    .mon-stage-text { max-width: none; padding: 20px 0 var(--m); }
    .mon-note { align-self: start; }
    .mon-note dl div { grid-template-columns: 1fr; gap: 2px; }

    .mon-record-body { grid-template-columns: 1fr; }
    .mon-record-intro, .mon-record-lists { grid-column: 1; }
    .mon-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }

    .mon-corners { grid-template-columns: 1fr; gap: 40px; }
    .mon-corners figure { grid-column: 1; padding-top: 0 !important; }
    .mon-corners figure:nth-of-type(2) { margin-left: 18%; }
    .mon-voices-note { grid-column: 1; }
    .mon-lead { text-align: left; justify-self: start; }

    .mon-about-grid { grid-template-columns: 1fr; }
    .mon-about-text, .mon-about-facts { grid-column: 1; }

    .mon-contact-top { grid-template-columns: 1fr; }
    .mon-contact-top .mon-h2, .mon-contact-lead { grid-column: 1; }
    .mon-brief .bb-who { grid-template-columns: 1fr; }
    .mon-email { flex-direction: column; }

    .mon-footer-row { grid-template-columns: 1fr 1fr; }
    .mon-places { grid-column: 1 / -1; }
    .mon-footer-links { grid-column: 1; }
    .mon-footer-note { grid-column: 2; }
  }

  @media (max-width: 520px) {
    .mon-hero-actions { flex-direction: column; align-items: stretch; gap: 16px; }
    .mon-hero-actions .mon-btn { width: 100%; }
    .mon-brief .bb-sentence { line-height: 1.7; }
    .mon-table th:nth-child(3), .mon-table td:nth-child(3) { display: none; }
    .mon-contact-foot { flex-direction: column; }
  }

  /* Motion: shutter on the name's photograph, staged entrances, the moving band, a slow drift on the stage photographs */
  @media (prefers-reduced-motion: no-preference) {
    .mon.js [data-shutter] { clip-path: inset(100% 0 0 0); transition: clip-path 1100ms var(--ease-in-out) 150ms; }
    .mon.js [data-shutter] img { transform: scale(1.12); transition: transform 1500ms var(--ease-soft) 150ms; }
    .mon.js [data-shutter].is-in { clip-path: inset(0); }
    .mon.js [data-shutter].is-in img { transform: none; }

    .mon.js .mon-name > span:not(.mon-glyph) { display: inline-block; transform: translateY(0.18em); opacity: 0; transition: transform 900ms var(--ease-expo), opacity 600ms ease; }
    .mon.js .mon-name.is-in > span:not(.mon-glyph) { transform: none; opacity: 1; }
    .mon.js .mon-name.is-in > span:last-child { transition-delay: 120ms; }

    .mon.js [data-reveal] { opacity: 0; transform: translateY(24px); transition: opacity 700ms ease var(--d, 0ms), transform 800ms var(--ease-out) var(--d, 0ms); }
    .mon.js [data-reveal].is-in { opacity: 1; transform: none; }
    .mon.js :is(h2)[data-reveal] { opacity: 1; transform: translateY(0.35em); transition: transform 900ms var(--ease-expo) var(--d, 0ms); }
    .mon.js :is(h2)[data-reveal].is-in { transform: none; }

    .mon-marquee-track { animation: mon-marquee 48s linear infinite; }
    .mon-marquee:hover .mon-marquee-track { animation-play-state: paused; }

    @supports (animation-timeline: view()) {
      .mon-stage-pic {
        animation: mon-open linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 40%;
      }
    }
  }

  @keyframes mon-marquee {
    to { transform: translateX(-50%); }
  }

  @keyframes mon-open {
    from { clip-path: inset(14% 0 14% 0); }
    to { clip-path: inset(0); }
  }
</style>

<script>
  const root = document.querySelector('.mon');
  if (root) {
    root.classList.add('js');
    const name = root.querySelector('.mon-name');
    const shutter = root.querySelector('[data-shutter]');
    requestAnimationFrame(() => requestAnimationFrame(() => {
      name?.classList.add('is-in');
      shutter?.classList.add('is-in');
    }));

    const items = root.querySelectorAll('[data-reveal]');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        });
      }, { rootMargin: '0px 0px 12% 0px' });
      items.forEach((el) => io.observe(el));
    } else {
      items.forEach((el) => el.classList.add('is-in'));
    }
  }
</script>
