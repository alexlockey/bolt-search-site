---
// Concept B, "The printed annual".
// Idea: the search report Alex hands a client at shortlist becomes the page itself.
// Palette: the dealt proportions (paper, one ink, solid colour pages) with the colours taken from the subject:
// Bolt Search's own logo ink, navy and blue.
import BriefBuilder from '../BriefBuilder.astro';
import { hero, navLinks, method, shortlistNote, facts, placements, roles, quotes, about, brief, contact } from '../../data/site';

const [leadQuote, ...moreQuotes] = quotes;
const record = [
  'Recruiting since 2007',
  'Bolt Search since 2016',
  '50+ placements on record by 2023',
  '15 recommendations on LinkedIn',
  'One person runs every search',
];
const year = new Date().getFullYear();
---

<link rel="preconnect" href="https://api.fontshare.com" />
<link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
<link href="https://api.fontshare.com/v2/css?f[]=gambarino@400&display=swap" rel="stylesheet" />
<link href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500&display=swap" rel="stylesheet" />

<div class="ann">
  <header class="ann-bar">
    <a href="/concepts/b/" class="ann-mark" aria-label="Bolt Search, home">
      <img src="/bolt-search-logo.png" alt="Bolt Search" width="153" height="34" />
    </a>
    <nav class="ann-links" aria-label="Main">
      {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href={hero.action.href} class="ann-btn ann-btn-sm">{hero.action.label}</a>
    </nav>
  </header>

  <main>
    <!-- 1. Hero: narrow talk, wide headline -->
    <section class="ann-hero" aria-labelledby="ann-title">
      <div class="ann-hero-talk">
        <p class="ann-lead" data-after>{hero.support}</p>
        <a href={hero.action.href} class="ann-btn" data-after>{hero.action.label}</a>
        <a href={hero.second.href} class="ann-textlink" data-after>{hero.second.label}</a>
      </div>
      <div class="ann-hero-main">
        <h1 id="ann-title" class="ann-title">
          <span class="ann-line"><span data-line style="--i:0">Hires that carry</span></span>
          <span class="ann-line"><span data-line style="--i:1">the number</span></span>
        </h1>
        <figure class="ann-hero-fig">
          <div class="ann-hero-crop">
            <img src="/images/alex-headshot.webp" alt="Alex Lockey, founder of Bolt Search" width="896" height="1200" fetchpriority="high" />
          </div>
          <div class="ann-stat">
            <p class="ann-stat-figure">{facts[0].figure}</p>
            <p>{facts[0].label}</p>
          </div>
        </figure>
      </div>
    </section>

    <!-- 2. How it works: lines that step across -->
    <section class="ann-section ann-method" id="method" aria-labelledby="ann-method-h">
      <div class="ann-side" data-reveal>
        <h2 id="ann-method-h" class="ann-h2">{method.heading}</h2>
        <p>{method.note}</p>
      </div>
      <ol class="ann-stairs">
        {method.stages.map((s, i) => (
          <li style={`--step:${i}`} data-reveal>
            <h3 class="ann-stair">{s.line}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- The report's main figure: the shortlist note, on a navy page -->
    <section class="ann-page ann-navy" aria-labelledby="ann-note-h">
      <div class="ann-side" data-reveal>
        <h2 id="ann-note-h" class="ann-h2">A note with every name</h2>
        <p>Each person on a shortlist arrives with one. This is an example; the candidate is not real.</p>
      </div>
      <figure class="ann-note" data-reveal>
        <figcaption class="ann-note-title">{shortlistNote.candidate}</figcaption>
        <dl>
          {shortlistNote.rows.map(([k, v]) => (
            <div class="ann-note-row">
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
      </figure>
    </section>

    <!-- 3. Proof: plain names in columns -->
    <section class="ann-section ann-record" id="record" aria-labelledby="ann-record-h">
      <div class="ann-record-head" data-reveal>
        <h2 id="ann-record-h" class="ann-h2">Track record</h2>
        <figure class="ann-record-fig">
          <img src="/images/found/card-index.webp" alt="An open drawer of a wooden card index" width="1600" height="1200" loading="lazy" />
          <figcaption>A market, before it is mapped.</figcaption>
        </figure>
      </div>
      <div class="ann-cols" data-reveal>
        <ul>
          <li class="ann-kind">The record</li>
          {record.map((r) => <li>{r}</li>)}
        </ul>
        <ul>
          <li class="ann-kind">Recent placements</li>
          {placements.map((p) => (
            <li>{p.role}<span class="ann-soft">, {p.company.toLowerCase()}, {p.year}</span></li>
          ))}
        </ul>
        <ul>
          <li class="ann-kind">Roles we fill</li>
          {roles.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </section>

    <!-- 4. Testimonial: portrait and offset quotation, on a blue page -->
    <section class="ann-page ann-blue" aria-labelledby="ann-quotes-h">
      <h2 id="ann-quotes-h" class="ann-hidden-h">What clients and candidates say</h2>
      <figure class="ann-q-photo" data-reveal>
        <img src="/images/alex-client-table.webp" alt="Alex Lockey taking a brief with two clients" width="896" height="1200" loading="lazy" />
      </figure>
      <div class="ann-q-main">
        <blockquote class="ann-q-lead" data-reveal>
          <p>{leadQuote.text}</p>
          <footer>{leadQuote.who}</footer>
        </blockquote>
        <div class="ann-q-more">
          {moreQuotes.map((q) => (
            <blockquote data-reveal>
              <p>{q.text}</p>
              <footer>{q.who}</footer>
            </blockquote>
          ))}
        </div>
        <p class="ann-q-note" data-reveal>
          Paraphrased from fifteen LinkedIn recommendations. <a href={hero.second.href}>Ask to speak to a reference</a>.
        </p>
      </div>
    </section>

    <!-- 5. About: wide photo, colour tile, facts -->
    <section class="ann-section ann-about" id="alex" aria-labelledby="ann-about-h">
      <div class="ann-about-top" data-reveal>
        <h2 id="ann-about-h" class="ann-h2">{about.heading}</h2>
        <p class="ann-lead">{about.body[0]}</p>
      </div>
      <div class="ann-mosaic">
        <figure class="ann-wide" data-reveal>
          <img src="/images/alex-whiteboard.webp" alt="Alex Lockey working through a plan on a whiteboard" width="896" height="1200" loading="lazy" />
          <p class="ann-wide-note">{about.body[1]}</p>
        </figure>
        <div class="ann-tile-wrap" data-reveal>
          <div class="ann-tile">
            <p class="ann-tile-figure">{facts[3].figure}</p>
            <p>{facts[3].label}</p>
          </div>
          <dl class="ann-pairs">
            {about.facts.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{k === 'Reach' ? <a href={`mailto:${v}`}>{v}</a> : v}</dd>
              </div>
            ))}
            <div>
              <dt>Profile</dt>
              <dd><a href={about.linkedin} target="_blank" rel="noopener">LinkedIn</a></dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- 6. Contact: the brief sentence -->
    <section class="ann-section ann-brief" id="brief" aria-labelledby="ann-brief-h">
      <div class="ann-brief-main" data-reveal>
        <h2 id="ann-brief-h" class="ann-h2">{brief.heading}</h2>
        <p class="ann-brief-lead">{brief.lead}</p>
        <BriefBuilder />
        <p class="ann-soft ann-after">{brief.after}</p>
      </div>
      <div class="ann-side ann-brief-side" data-reveal>
        <img src="/images/alex-about-600.webp" alt="Alex Lockey" width="600" height="803" loading="lazy" class="ann-brief-face" />
        <div>
          <p class="ann-strong">Rather write it yourself?</p>
          <p><a href={`mailto:${contact.email}`}>{contact.email}</a><br /><a href={contact.linkedin} target="_blank" rel="noopener">Alex on LinkedIn</a></p>
          <p class="ann-soft">{contact.reply}</p>
        </div>
      </div>
    </section>
  </main>

  <!-- 7. Footer: name first, places under it -->
  <footer class="ann-foot">
    <p class="ann-foot-name" aria-hidden="true">Bolt Search</p>
    <div class="ann-foot-row">
      <ul class="ann-places">
        <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li><a href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
      </ul>
      <ul class="ann-foot-links">
        {navLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href="/contact/">Contact form</a></li>
      </ul>
      <p class="ann-foot-where">{contact.where}</p>
    </div>
    <div class="ann-foot-legal">
      <p>&copy; {year} Bolt Search. Card index photograph: "UNOG Library Filing Cabinet" by Mourad Ben Abdallah, <a href="https://creativecommons.org/licenses/by-sa/3.0" rel="noopener">CC BY-SA 3.0</a>, <a href="https://commons.wikimedia.org/wiki/File:UNOG_Library_Filing_Cabinet.JPG" rel="noopener">Wikimedia Commons</a>.</p>
      <a href="#ann-title">Back to top</a>
    </div>
  </footer>
</div>

<script is:inline>
  document.documentElement.classList.add('ann-js');
</script>

<script>
  const els = document.querySelectorAll<HTMLElement>('.ann [data-reveal]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px' }
    );
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach((el) => el.classList.add('is-in'));
  }

  // One moving picture: the hero photograph drifts slowly as the page scrolls.
  const crop = document.querySelector<HTMLElement>('.ann-hero-crop img');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (crop && !still) {
    let ticking = false;
    const move = () => {
      const y = Math.min(window.scrollY, 900);
      crop.style.transform = `translateY(${y * -0.08}px) scale(1.06)`;
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(move);
      }
    }, { passive: true });
    move();
  }
</script>

<style>
  .ann {
    --bg: #F4F5F6;
    --surface: #E5E7EB;
    --ink: #16151F;
    --soft: #4D4C5A;
    --navy: #1E1D30;
    --navy-ink: #F4F5F6;
    --navy-soft: #B9BBC9;
    --blue: #009EE2;
    --blue-ink: #16151F;
    --display: 'Gambarino', Georgia, 'Times New Roman', serif;
    --text: 'General Sans', -apple-system, 'Segoe UI', sans-serif;
    --step-small: 0.9375rem;
    --step-body: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    --step-lead: clamp(1.25rem, 1.1rem + 0.7vw, 1.625rem);
    --step-head: clamp(2.25rem, 1.5rem + 2.4vw, 3.25rem);
    --step-display: clamp(3.25rem, 8.2vw, 8.5rem);
    --m: clamp(20px, 2.4vw, 36px);
    --axis: 40%;
    --gap: 24px;
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);

    background: var(--bg);
    color: var(--ink);
    font-family: var(--text);
    font-size: var(--step-body);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }

  :global(body) { margin: 0; }
  :global(:where(.ann, .ann *, .ann *::before, .ann *::after)) { box-sizing: border-box; margin: 0; padding: 0; }
  .ann img { display: block; max-width: 100%; height: auto; }
  .ann a { color: inherit; text-underline-offset: 0.18em; text-decoration-thickness: 1px; transition: color 0.2s ease, text-decoration-color 0.2s ease; }
  .ann a:hover { color: var(--soft); }
  .ann a:focus-visible, .ann button:focus-visible, .ann input:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
  :global(:where(.ann ul, .ann ol)) { list-style: none; }

  .ann-h2 {
    font-family: var(--display);
    font-weight: 400;
    font-size: var(--step-head);
    line-height: 0.98;
    letter-spacing: -0.02em;
    max-width: 14ch;
    text-wrap: balance;
  }

  .ann-lead { font-size: var(--step-lead); line-height: 1.35; }
  .ann-soft { color: var(--soft); }
  .ann-strong { font-weight: 500; }

  .ann-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 26px;
    background: var(--ink);
    color: var(--bg) !important;
    font: 500 var(--step-small)/1 var(--text);
    text-decoration: none;
    border: 0;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s var(--ease-out);
  }
  .ann-btn:hover { background: var(--navy); }
  .ann-btn:active { transform: scale(0.97); }
  .ann-btn-sm { min-height: 44px; padding: 0 18px; }

  .ann-textlink { text-decoration: underline; font-weight: 500; }

  /* Bar */
  .ann-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--gap);
    padding: 20px var(--m);
  }
  .ann-mark img { height: 30px; width: auto; }
  .ann-links { display: flex; align-items: center; gap: 28px; font-size: var(--step-small); }
  .ann-links a:not(.ann-btn) { text-decoration: none; }
  .ann-links a:not(.ann-btn):hover { text-decoration: underline; color: var(--ink); }

  /* Hero */
  .ann-hero {
    display: grid;
    grid-template-columns: var(--axis) 1fr;
    column-gap: var(--gap);
    padding: clamp(24px, 4vh, 56px) var(--m) 0;
    min-height: calc(100svh - 84px);
  }
  .ann-hero-talk {
    padding-top: 22vh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    max-width: 26rem;
  }
  .ann-hero-talk .ann-lead { max-width: 24ch; }
  .ann-title {
    font-family: var(--display);
    font-weight: 400;
    font-size: var(--step-display);
    line-height: 0.92;
    letter-spacing: -0.025em;
  }
  .ann-line { display: block; overflow: hidden; padding-bottom: 0.1em; margin-bottom: -0.1em; }
  .ann-line [data-line] { display: block; }
  .ann-hero-fig { position: relative; margin-top: clamp(96px, 13vh, 128px); }
  .ann-hero-crop { height: 46svh; min-height: 300px; overflow: hidden; }
  .ann-hero-crop img { width: 100%; height: 130%; object-fit: cover; object-position: 50% 22%; will-change: transform; }
  .ann-stat {
    position: absolute;
    left: 0;
    top: 0;
    transform: translateY(-50%);
    width: 270px;
    padding: 20px 22px;
    background: var(--blue);
    color: var(--blue-ink);
    font-size: var(--step-small);
    line-height: 1.35;
  }
  .ann-stat-figure { font-family: var(--display); font-size: var(--step-head); line-height: 1; margin-bottom: 6px; }

  /* Shared section frame */
  .ann-section, .ann-page {
    display: grid;
    grid-template-columns: var(--axis) 1fr;
    column-gap: var(--gap);
    padding: clamp(80px, 8.5vw, 132px) var(--m);
  }
  .ann-side { display: flex; flex-direction: column; gap: 20px; max-width: 30rem; padding-right: var(--gap); align-self: start; position: sticky; top: 32px; }
  .ann-side p { color: inherit; }

  /* Method stairs */
  .ann-stairs { display: grid; gap: 56px; }
  .ann-stairs li { margin-left: calc(var(--step) * 7%); max-width: 46rem; }
  .ann-stair {
    font-family: var(--display);
    font-weight: 400;
    font-size: var(--step-head);
    line-height: 1.04;
    letter-spacing: -0.015em;
    margin-bottom: 12px;
    text-wrap: balance;
  }
  .ann-stairs li:last-child .ann-stair { color: #0079AD; }
  .ann-stairs p { max-width: 38ch; color: var(--soft); }

  /* Navy page: the note */
  .ann-navy { background: var(--navy); color: var(--navy-ink); }
  .ann-navy .ann-side p { color: var(--navy-soft); }
  .ann-note { background: var(--bg); color: var(--ink); padding: clamp(24px, 3vw, 48px); }
  .ann-note-title { font-family: var(--display); font-size: var(--step-head); line-height: 1; letter-spacing: -0.02em; margin-bottom: 28px; }
  .ann-note dl { display: grid; gap: 4px; }
  .ann-note-row {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: var(--gap);
    padding: 16px 18px;
    background: var(--surface);
  }
  .ann-note dt { font-weight: 500; }
  .ann-note dd { font-size: var(--step-lead); line-height: 1.3; }

  /* Record */
  .ann-record-head { display: flex; flex-direction: column; gap: 32px; padding-right: var(--gap); }
  .ann-record-fig img { aspect-ratio: 4 / 3; object-fit: cover; width: 100%; }
  .ann-record-fig figcaption { margin-top: 10px; font-size: var(--step-small); color: var(--soft); }
  .ann-cols { columns: 3 14rem; column-gap: 32px; }
  .ann-cols ul { break-inside: avoid-column; margin-bottom: 40px; }
  .ann-cols li { line-height: 1.45; margin-bottom: 10px; }
  .ann-cols .ann-kind { color: var(--soft); }

  /* Blue page: quotations */
  .ann-blue { background: var(--blue); color: var(--blue-ink); grid-template-columns: repeat(12, minmax(0, 1fr)); }
  .ann-hidden-h { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .ann-q-photo { grid-column: 1 / span 4; align-self: start; }
  .ann-q-photo img { aspect-ratio: 3 / 4; object-fit: cover; width: 100%; max-height: 74svh; }
  .ann-q-main { grid-column: 6 / span 7; padding-top: 120px; }
  .ann-q-lead p { font-family: var(--display); font-size: clamp(1.375rem, 1rem + 1.4vw, 2.25rem); line-height: 1.2; max-width: 34ch; }
  .ann-q-lead footer, .ann-q-more footer { margin-top: 16px; font-size: var(--step-small); }
  .ann-q-more { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px var(--gap); margin-top: 72px; }
  .ann-q-more p { font-size: var(--step-body); line-height: 1.45; }
  .ann-q-note { margin-top: 56px; }
  .ann-q-note a { text-decoration: underline; }
  .ann-blue a:hover { color: var(--navy); }

  /* About mosaic */
  .ann-about { grid-template-columns: repeat(12, minmax(0, 1fr)); }
  .ann-about-top { grid-column: 1 / span 7; display: flex; flex-direction: column; gap: 24px; margin-bottom: 72px; }
  .ann-mosaic { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 0 var(--gap); align-items: start; }
  .ann-wide { grid-column: 1 / span 8; position: relative; }
  .ann-wide img { aspect-ratio: 16 / 10; object-fit: cover; object-position: 50% 16%; width: 100%; }
  .ann-wide-note {
    position: absolute;
    top: 0;
    right: 0;
    width: min(340px, 50%);
    padding: 22px;
    background: var(--bg);
    font-size: var(--step-small);
    line-height: 1.45;
  }
  .ann-tile-wrap { grid-column: 9 / span 4; display: flex; flex-direction: column; gap: 28px; }
  .ann-tile { background: var(--navy); color: var(--navy-ink); padding: 28px; aspect-ratio: 16 / 13; display: flex; flex-direction: column; justify-content: flex-end; gap: 8px; }
  .ann-tile-figure { font-family: var(--display); font-size: var(--step-display); line-height: 0.85; }
  .ann-pairs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px var(--gap); font-size: var(--step-small); }
  .ann-pairs dt { color: var(--soft); }
  .ann-pairs dd { font-size: var(--step-body); overflow-wrap: anywhere; }

  /* Brief */
  .ann-brief { background: var(--surface); }
  .ann-brief-side { grid-column: 1; grid-row: 1; flex-direction: row; align-items: flex-start; gap: 20px; align-self: end; }
  .ann-brief-face { width: 120px; aspect-ratio: 1; object-fit: cover; object-position: 50% 20%; flex: none; }
  .ann-brief-side div { display: flex; flex-direction: column; gap: 10px; }
  .ann-brief-main { grid-column: 2; grid-row: 1; display: flex; flex-direction: column; gap: 24px; }
  .ann-brief-lead { font-size: var(--step-lead); line-height: 1.35; max-width: 36ch; }
  .ann-after { font-size: var(--step-small); }

  .ann :global(.bb) { display: flex; flex-direction: column; gap: 32px; margin-top: 8px; }
  .ann :global(.bb-sentence) {
    font-family: var(--display);
    font-size: var(--step-lead);
    line-height: 1.6;
    letter-spacing: -0.01em;
    max-width: 40ch;
  }
  .ann :global(.bb-slot input) {
    border: 0;
    border-bottom: 2px solid var(--ink);
    background: var(--bg);
    padding: 0 8px;
    margin: 0 4px;
    color: var(--ink);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .ann :global(.bb-slot input::placeholder) { color: #8A8996; }
  .ann :global(.bb-slot input:focus) { outline: none; background: #FFFFFF; border-color: var(--blue); }
  .ann :global(.bb-slot input[aria-invalid="true"]), .ann :global(.bb-field input[aria-invalid="true"]) { border-color: #B42318; }
  .ann :global(.bb-who) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px var(--gap); }
  .ann :global(.bb-field) { display: flex; flex-direction: column; gap: 6px; font-size: var(--step-small); font-weight: 500; }
  .ann :global(.bb-field input) {
    font: 400 var(--step-body)/1.4 var(--text);
    padding: 13px 14px;
    background: var(--bg);
    color: var(--ink);
    border: 2px solid transparent;
    transition: border-color 0.2s ease;
  }
  .ann :global(.bb-field input:focus) { outline: none; border-color: var(--blue); }
  .ann :global(.bb-actions) { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; }
  .ann :global(.bb-send) {
    min-height: 56px;
    padding: 0 30px;
    background: var(--ink);
    color: var(--bg);
    border: 0;
