---
// The narrowing, in the Visualize Value grammar: hollow circles are people, the dashed ring is
// "not looking", the filled blue circle is the hire. Desktop: one wide diagram with labels under each stage.
// Below 880px: one row per stage, the stage's own drawing paired with its number and words.
import { narrowing } from '../data/site';
const stages = narrowing.stages;

type Dot = { x: number; y: number; r: number; s: number };

// Desktop: columns of circles that thin out left to right.
const W = 1122;
const centres = [140, 400, 600, 760, 900, 1060];
const radii = [4, 5, 6, 7.5, 11, 22];
const gaps = [6, 7, 8, 9, 14, 0];
const boxes: [number, number][] = [[200, 300], [130, 220], [96, 180], [60, 140], [40, 120], [44, 44]];
function columnDots(count: number, cx: number, w: number, h: number, r: number, gap: number) {
  const cols = Math.max(1, Math.round(Math.sqrt((count * w) / h)));
  const rows = Math.ceil(count / cols);
  const step = r * 2 + gap;
  const x0 = cx - ((cols - 1) * step) / 2;
  const y0 = 210 - ((rows - 1) * step) / 2;
  return Array.from({ length: count }, (_, i) => ({ x: x0 + (i % cols) * step, y: y0 + Math.floor(i / cols) * step }));
}
const dots: Dot[] = stages.flatMap((st, s) =>
  columnDots(st.count, centres[s], boxes[s][0], boxes[s][1], radii[s], gaps[s]).map((p) => ({ ...p, r: radii[s], s }))
);

// Phone: each stage drawn in its own 112 x 136 tile (112 square plus a short arrow to the next stage).
const T = 112;
const mini = [
  { r: 2.4, gap: 2.6 },
  { r: 3.6, gap: 3.2 },
  { r: 4.6, gap: 4.4 },
  { r: 6.5, gap: 6 },
  { r: 10, gap: 10 },
  { r: 20, gap: 0 },
];
function tileDots(count: number, r: number, gap: number) {
  const cols = Math.ceil(Math.sqrt(count));
  const rows = Math.ceil(count / cols);
  const step = r * 2 + gap;
  const x0 = T / 2 - ((cols - 1) * step) / 2;
  const y0 = T / 2 - ((rows - 1) * step) / 2;
  return Array.from({ length: count }, (_, i) => ({ x: x0 + (i % cols) * step, y: y0 + Math.floor(i / cols) * step }));
}
const tiles = stages.map((st, s) => tileDots(st.count, mini[s].r, mini[s].gap).map((p) => ({ ...p, r: mini[s].r, s })));
const label = `An illustrative search: ${stages.map((s) => `${s.count} ${s.name.toLowerCase()}`).join(', ')}.`;
---

<figure class="bs-diagram" data-diagram>
  <svg class="bs-dg-wide" viewBox={`0 72 ${W} 276`} role="img" aria-label={label}>
    <g fill="none" stroke-width="1.5">
      {[0, 1, 2, 3, 4].map((s) => (
        <g class="bs-dg-arrow" style={`--s:${s}`}>
          <line x1={centres[s] + boxes[s][0] / 2 + 14} y1="210" x2={centres[s + 1] - boxes[s + 1][0] / 2 - 18} y2="210" />
          <polyline points={`${centres[s + 1] - boxes[s + 1][0] / 2 - 26},202 ${centres[s + 1] - boxes[s + 1][0] / 2 - 18},210 ${centres[s + 1] - boxes[s + 1][0] / 2 - 26},218`} />
        </g>
      ))}
      <circle class="bs-dg-dash" cx={centres[2]} cy="210" r="86" stroke-dasharray="4 7" />
    </g>
    {dots.map((d) => <circle class={`bs-dot bs-dot-s${d.s}`} cx={d.x} cy={d.y} r={d.r} style={`--s:${d.s}`} />)}
  </svg>

  <ol class="bs-stages" aria-hidden="true">
    {stages.map((st, i) => (
      <li style={`--s:${i};--x:${(centres[i] / W) * 100}%`}>
        <span class="bs-count">{st.count}</span>
        <span class="bs-stage">{st.name}</span>
        <span class="bs-stage-note">{st.note}</span>
      </li>
    ))}
  </ol>

  <ol class="bs-stage-rows">
    {stages.map((st, s) => (
      <li>
        <svg viewBox={`0 0 ${T} ${s < stages.length - 1 ? 136 : T}`} aria-hidden="true" focusable="false">
          {s === 2 && <circle class="bs-dg-dash" cx={T / 2} cy={T / 2} r="50" fill="none" stroke-width="1.5" stroke-dasharray="4 6" />}
          {tiles[s].map((d) => <circle class={`bs-dot bs-dot-s${d.s}`} cx={d.x} cy={d.y} r={d.r} style={`--s:${d.s}`} />)}
          {s < stages.length - 1 && (
            <g class="bs-stage-arrow" fill="none" stroke-width="1.5">
              <line x1={T / 2} y1="116" x2={T / 2} y2="132" />
              <polyline points={`${T / 2 - 5},127 ${T / 2},132 ${T / 2 + 5},127`} />
            </g>
          )}
        </svg>
        <div class="bs-row-text">
          <span class="bs-count">{st.count}</span>
          <span class="bs-stage">{st.name}</span>
          <span class="bs-stage-note">{st.note}</span>
        </div>
      </li>
    ))}
  </ol>

  <figcaption>{narrowing.caption}</figcaption>
</figure>
