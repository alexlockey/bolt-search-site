---
// Concept B, the Instrument: a search shown as a measured process, on a dark ground.
import Artefact from '../Artefact.astro';
import { hero, facts, roles, method, quotes, placements, about, closing } from '../../data/site';
---

<section class="b-hero">
  <div class="container-wide">
    <h1>{hero.title}</h1>
    <div class="b-hero-row">
      <p class="lede">{hero.lede}</p>
      <div class="b-actions">
        <a href={hero.primary.href} class="btn btn-primary">{hero.primary.label}</a>
        <a href={hero.secondary.href} class="btn btn-outline">{hero.secondary.label}</a>
      </div>
    </div>
    <div class="b-console">
      <Artefact kind="map" fig="FIG. 1" variant="panel" />
      <Artefact kind="shortlist" fig="FIG. 2" variant="panel" />
    </div>
  </div>
</section>

<section class="b-facts-band" aria-label="Track record">
  <div class="container-wide">
    <dl class="b-facts">
      {facts.map((f) => (
        <div>
          <dt>{f.figure}</dt>
          <dd>{f.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section class="section" id="how">
  <div class="container-wide">
    <div class="b-head">
      <h2>{method.title}</h2>
      <p>{method.intro}</p>
    </div>
    <ol class="b-steps">
      {method.steps.map((s) => (
        <li>
          <h3>{s.name}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
    <div class="b-brief">
      <Artefact kind="brief" fig="FIG. 3" variant="panel" />
    </div>
  </div>
</section>

<section class="section section-subtle">
  <div class="container-wide">
    <div class="b-head">
      <h2>What clients and candidates say</h2>
      <p>Paraphrased from fifteen LinkedIn recommendations. References on request.</p>
    </div>
    <div class="b-quotes">
      {quotes.slice(0, 3).map((q) => (
        <blockquote>
          <p>{q.text}</p>
          <footer class="mono">{q.who}</footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="container-wide b-two">
    <div>
      <h2>Placement log</h2>
      <p>Roles and company types only. Nobody is named without permission.</p>
      <table class="b-table">
        <tbody>
          {placements.map((p) => (
            <tr><td class="mono b-year">{p.year}</td><td><span class="b-role">{p.role}</span><span class="b-co">{p.company}</span></td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <div>
      <h2>Roles we fill</h2>
      <p>Commercial and technical people who carry a number or win the technical sale, in any market.</p>
      <ul class="b-roles">
        {roles.map((r) => <li>{r}</li>)}
      </ul>
    </div>
  </div>
</section>

<section class="section section-subtle">
  <div class="container-wide b-about">
    <img src="/alex-lockey.jpg" alt="Alex Lockey" width="200" height="200" loading="lazy" />
    <div>
      <h2>{about.name}</h2>
      <p class="mono">{about.title}</p>
      {about.body.map((t) => <p>{t}</p>)}
      <a href={about.linkedin} target="_blank" rel="noopener">Alex on LinkedIn</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container-wide b-close">
    <h2>{closing.title}</h2>
    <p>{closing.body}</p>
    <div class="b-actions">
      <a href={hero.primary.href} class="btn btn-primary">{hero.primary.label}</a>
      <a href={hero.secondary.href} class="btn btn-outline">{hero.secondary.label}</a>
    </div>
  </div>
</section>

<style>
  .b-hero {
    padding: var(--space-4xl) 0 var(--space-3xl);
  }

  .b-hero h1 {
    max-width: 14ch;
    font-size: clamp(2.75rem, 7.5vw, 5.75rem);
    line-height: 0.98;
  }

  .b-hero-row {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) auto;
    gap: var(--space-2xl);
    align-items: end;
    margin: var(--space-xl) 0 var(--space-3xl);
  }

  .b-hero-row .lede {
    margin: 0;
  }

  .b-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .b-console {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-lg);
  }

  .b-facts-band {
    background: var(--color-bg-subtle);
    padding: var(--space-2xl) 0;
  }

  .b-facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .b-facts dt {
    font-family: var(--font-mono); /* taste-skill-ignore: approved Plex Mono labels, see CLAUDE.md */
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    font-weight: 500;
    color: var(--color-accent);
    line-height: 1.1;
    margin-bottom: var(--space-xs);
  }

  .b-facts dd {
    color: var(--color-fg-muted);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .b-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-2xl);
    align-items: end;
    margin-bottom: var(--space-2xl);
  }

  .b-head p {
    margin: 0;
  }

  .b-steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .b-steps li {
    background: var(--color-bg-subtle);
    border-radius: 8px;
    padding: var(--space-lg);
  }

  .b-steps h3 {
    margin-bottom: var(--space-xs);
  }

  .b-steps li > p:last-child {
    margin: 0;
    font-size: 0.9375rem;
  }

  .b-brief {
    margin-top: var(--space-lg);
    max-width: 44rem;
  }

  .b-quotes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .b-quotes blockquote {
    background: var(--color-bg-elevated);
    border-radius: 8px;
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .b-quotes p {
    color: var(--color-fg);
    font-size: 1.0625rem;
    line-height: 1.55;
    margin: 0;
  }

  .b-two {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--space-3xl);
    align-items: start;
  }

  .b-two h2 {
    margin-bottom: var(--space-sm);
  }

  .b-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 2px;
    margin-top: var(--space-lg);
  }

  .b-table td {
    background: var(--color-bg-subtle);
    padding: 0.75rem 0.875rem;
    vertical-align: top;
  }

  .b-year {
    width: 4.5rem;
    color: var(--color-accent);
    border-radius: 4px 0 0 4px;
  }

  .b-table td:last-child {
    border-radius: 0 4px 4px 0;
  }

  .b-role {
    display: block;
    color: var(--color-fg);
    font-weight: 500;
  }

  .b-co {
    display: block;
    color: var(--color-fg-subtle);
    font-size: 0.875rem;
  }

  .b-roles {
    list-style: none;
    display: grid;
    gap: 2px;
    margin-top: var(--space-lg);
  }

  .b-roles li {
    background: var(--color-bg-subtle);
    padding: 0.75rem 0.875rem;
    border-radius: 4px;
    color: var(--color-fg);
  }

  .b-about {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--space-2xl);
    align-items: start;
    max-width: 56rem;
  }

  .b-about img {
    border-radius: 8px;
    filter: grayscale(1);
  }

  .b-about .mono {
    margin: 0.25rem 0 var(--space-lg);
  }

  .b-close {
    max-width: 46rem;
  }

  .b-close h2 {
    margin-bottom: var(--space-md);
  }

  .b-close .b-actions {
    margin-top: var(--space-xl);
  }

  @media (max-width: 960px) {
    .b-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .b-quotes { grid-template-columns: 1fr; }
  }

  @media (max-width: 820px) {
    .b-hero-row, .b-console, .b-head, .b-two { grid-template-columns: 1fr; }
    .b-hero-row { gap: var(--space-lg); }
    .b-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .b-hero { padding: var(--space-3xl) 0 var(--space-2xl); }
    .b-steps { grid-template-columns: 1fr; }
    .b-about { grid-template-columns: 1fr; }
    .b-about img { max-width: 160px; }
  }
</style>
